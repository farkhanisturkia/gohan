func RoleUpdate(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        id := gohan.Param(r, "id")

        var req UpdateRoleRequest
        if err := gohan.BindJSON(r, &req); err != nil {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{
                "message": "Invalid request body",
            })
            return
        }

        var item migrations.Role
        if err := db.FindOne(&item, "id = ?", id); err != nil {
            gohan.JSON(w, http.StatusNotFound, map[string]string{
                "message": "Role not found",
            })
            return
        }

        if req.Name != "" {
            item.Name = req.Name
        }

        err := db.Transaction(func(tx *gohan.Tx) error {
            return tx.Update(&item, id)
        })

        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to update Role",
            })
            return
        }

{{- if .UseRedis }}
        clearRoleCache(r.Context(), fmt.Sprintf("role:%s", id))

{{- end }}
        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Role updated successfully",
            "data":    item,
        })
    }
}

func RoleDestroy(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        id := gohan.Param(r, "id")

        var item migrations.Role
        if err := db.FindOne(&item, "id = ?", id); err != nil {
            gohan.JSON(w, http.StatusNotFound, map[string]string{
                "message": "Role not found",
            })
            return
        }

        err := db.Transaction(func(tx *gohan.Tx) error {
            return tx.Delete(&migrations.Role{}, id)
        })

        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to delete Role",
            })
            return
        }

{{- if .UseRedis }}
        clearRoleCache(r.Context(), fmt.Sprintf("role:%s", id))

{{- end }}
        gohan.JSON(w, http.StatusOK, map[string]string{
            "message": "Role deleted successfully",
        })
    }
}
{{- if .UseRedis }}

func clearRoleCache(ctx context.Context, extraKeys ...string) {
    for _, key := range extraKeys {
        gohan.CacheForget(ctx, gohan.Redis, key)
    }

    iter := gohan.Redis.Scan(ctx, 0, "role:all*", 0).Iterator()
    for iter.Next(ctx) {
        gohan.CacheForget(ctx, gohan.Redis, iter.Val())
    }
}
{{- end }}