package services

import (
    "context"
    "errors"
    "fmt"
    "log"
    "time"

    "github.com/farkhanisturkia/gohan/pkg"
    authv1 "{{ .ModuleName }}/gen/auth"
    "{{ .ModuleName }}/database/migrations"
)

type PasswordResetService struct {
    db *gohan.DB
}

func NewPasswordResetService(db *gohan.DB) *PasswordResetService {
    return &PasswordResetService{db: db}
}

func (s *PasswordResetService) ForgotPassword(ctx context.Context, req *gohan.Request[authv1.ForgotPasswordRequest]) (*gohan.Response[authv1.ForgotPasswordResponse], error) {
    in := req.Msg

    var user migrations.User
    if err := s.db.FindOne(&user, "email = ?", in.Email); err != nil {
        return gohan.NewResponse(&authv1.ForgotPasswordResponse{
            Message: "If your email is registered, you will receive a reset token.",
        }), nil
    }

    rawToken, err := gohan.GenerateRandomToken(32)
    if err != nil {
        return nil, gohan.NewError(gohan.CodeInternal, errors.New("Failed to generate token"))
    }

    hashedToken, err := gohan.HashToken(rawToken)
    if err != nil {
        return nil, gohan.NewError(gohan.CodeInternal, errors.New(err.Error()))
    }

    var existingReset migrations.PasswordReset
    if err := s.db.FindOne(&existingReset, "email = ?", in.Email); err == nil {
        _ = s.db.Delete(&migrations.PasswordReset{}, existingReset.ID)
    }

    resetRecord := migrations.PasswordReset{
        Email:     in.Email,
        Token:     hashedToken,
        ExpiresAt: time.Now().Add(15 * time.Minute),
    }

    if err := s.db.Create(&resetRecord); err != nil {
        return nil, gohan.NewError(gohan.CodeInternal, errors.New("Failed to save reset token"))
    }

    emailSubject := "Password Reset Request"
    emailBody := fmt.Sprintf(`
        <p>Klik tombol di bawah ini untuk mereset password kamu:</p>
        <p><a href="http://localhost:3000/forgot-password?token=%s&email=%s">Reset Password</a></p>
    `, rawToken, in.Email)

    if err := gohan.QueueEmail(in.Email, emailSubject, emailBody); err != nil {
        log.Printf("[MAIL QUEUE OVERLOAD] Failed to queue email for %s: %v\n", in.Email, err)

        go func(recipient, subject, body string) {
            if err := gohan.SendEmail(recipient, subject, body); err != nil {
                log.Printf("[MAIL FALLBACK ERROR] Failed to send email to %s: %v\n", recipient, err)
            }
        }(in.Email, emailSubject, emailBody)
    }

    return gohan.NewResponse(&authv1.ForgotPasswordResponse{
        Message: "Password reset token sent successfully to your email.",
    }), nil
}

func (s *PasswordResetService) ResetPassword(ctx context.Context, req *gohan.Request[authv1.ResetPasswordRequest]) (*gohan.Response[authv1.ResetPasswordResponse], error) {
    in := req.Msg

    hashedToken, err := gohan.HashToken(in.Token)
    if err != nil {
        return nil, gohan.NewError(gohan.CodeInternal, errors.New(err.Error()))
    }

    var resetRecord migrations.PasswordReset
    if err := s.db.FindOne(&resetRecord, "email = ? AND token = ?", in.Email, hashedToken); err != nil {
        return nil, gohan.NewError(gohan.CodeInvalidArgument, errors.New("Invalid or expired reset token"))
    }

    if time.Now().After(resetRecord.ExpiresAt) {
        _ = s.db.Delete(&migrations.PasswordReset{}, resetRecord.ID)
        return nil, gohan.NewError(gohan.CodeInvalidArgument, errors.New("Reset token has expired"))
    }

    var user migrations.User
    if err := s.db.FindOne(&user, "email = ?", in.Email); err != nil {
        return nil, gohan.NewError(gohan.CodeNotFound, errors.New("User not found"))
    }

    hashedPassword, err := gohan.HashPassword(in.NewPassword)
    if err != nil {
        return nil, gohan.NewError(gohan.CodeInternal, errors.New("Failed to hash password"))
    }

    user.Password = hashedPassword
    if err := s.db.Update(&user, user.ID); err != nil {
        return nil, gohan.NewError(gohan.CodeInternal, errors.New("Failed to update password"))
    }

    _ = s.db.Delete(&migrations.PasswordReset{}, resetRecord.ID)

    return gohan.NewResponse(&authv1.ResetPasswordResponse{
        Message: "Password updated successfully. Please login with your new password.",
    }), nil
}
