import { useState, useCallback } from 'react'

export function usePagination({ defaultPage = 1, defaultPerPage = 10 } = {}) {
  const [currentPage, setCurrentPage] = useState(defaultPage)
  const [perPage, setPerPageState] = useState(defaultPerPage)
  const [totalItems, setTotalItems] = useState(0)
  const [lastPage, setLastPage] = useState(1)

  const perPageOptions = [10, 25, 50, 100]

  const changePage = useCallback(
    (p: number) => {
      setCurrentPage((c) => {
        if (p < 1 || p > lastPage || p === c) return c
        return p
      })
    },
    [lastPage],
  )

  const setPerPage = (value: number) => {
    setPerPageState(value)
    setCurrentPage(1)
  }

  const paginationPages = (): (number | string)[] => {
    if (lastPage <= 7) return Array.from({ length: lastPage }, (_, i) => i + 1)

    const pages: (number | string)[] = [1]
    const start = Math.max(2, currentPage - 1)
    const end = Math.min(lastPage - 1, currentPage + 1)

    if (start > 2) pages.push('...')
    for (let i = start; i <= end; i++) pages.push(i)
    if (end < lastPage - 1) pages.push('...')

    pages.push(lastPage)
    return pages
  }

  const queryParams = { page: currentPage, per_page: perPage }

  const applyResponse = useCallback((payload: any): any[] => {
    if (Array.isArray(payload)) {
      setTotalItems(payload.length)
      setLastPage(1)
      return payload
    }

    setTotalItems(payload?.total ?? 0)
    setLastPage(payload?.last_page ?? 1)
    return payload?.data ?? []
  }, [])

  return {
    currentPage,
    perPage,
    totalItems,
    lastPage,
    perPageOptions,
    paginationPages,
    changePage,
    setPerPage,
    queryParams,
    applyResponse,
  }
}
