import { Component, OnInit, inject, signal } from '@angular/core'
import { ActivatedRoute, RouterLink } from '@angular/router'
import { api } from '../services/api'

@Component({
  selector: 'app-forgot-password',
  standalone: true,
  imports: [RouterLink],
  template: `
    <div>
      <div class="text-center mb-6">
        <h2 class="text-xl font-black tracking-wide text-purple-950 dark:text-purple-300 uppercase">
          {{ "{{" }} isResetMode() ? 'RESET PASSWORD' : 'FORGOT PASSWORD' }}
        </h2>
        <p class="text-xs text-purple-600/80 dark:text-slate-400 mt-1 font-medium">
          {{ "{{" }} isResetMode() ? 'Enter a new password for your account' : 'Enter your email address to receive a reset link' }}
        </p>
      </div>

      <!-- FORM 1: Reset Email -->
      @if (!isResetMode()) {
        <form (submit)="handleRequestLink($event)" class="space-y-4 max-w-sm mx-auto w-full">
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-purple-400 dark:text-slate-500">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
              </svg>
            </span>
            <input
              [value]="email()"
              (input)="email.set($any($event.target).value.trim())"
              type="email"
              placeholder="Email Address"
              required
              autocomplete="email"
              class="w-full pl-10 pr-4 py-2.5 rounded-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 placeholder-purple-300 dark:placeholder-slate-500 border border-slate-200 dark:border-slate-800 text-xs focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-500/20 transition-all"
            />
          </div>

          @if (errorMessage()) {
            <div class="text-rose-500 dark:text-rose-400 text-xs text-center font-medium pt-1">{{ "{{" }} errorMessage() }}</div>
          }

          @if (successMessage()) {
            <div class="text-emerald-600 dark:text-emerald-400 text-xs text-center font-medium pt-1">{{ "{{" }} successMessage() }}</div>
          }

          <button
            type="submit"
            [disabled]="isSubmitting()"
            class="w-full py-3 bg-purple-700 hover:bg-purple-800 active:bg-purple-900 dark:bg-purple-800 dark:hover:bg-purple-700 text-white font-bold tracking-wider rounded-2xl transition-all text-xs uppercase disabled:opacity-50 shadow-md shadow-purple-600/20 dark:shadow-purple-900/30 cursor-pointer"
          >
            {{ "{{" }} isSubmitting() ? 'SENDING LINK...' : 'SEND RESET LINK' }}
          </button>

          <div class="text-center pt-2">
            <a routerLink="/login" class="text-xs text-purple-700 dark:text-purple-400 font-bold hover:underline">Back to Login</a>
          </div>
        </form>
      }

      <!-- FORM 2: New Password -->
      @if (isResetMode()) {
        <form (submit)="handleResetPassword($event)" class="space-y-4 max-w-sm mx-auto w-full">
          <div class="relative">
            <input
              [value]="newPassword()"
              (input)="newPassword.set($any($event.target).value)"
              [type]="showNewPassword() ? 'text' : 'password'"
              placeholder="New Password"
              required
              autocomplete="new-password"
              class="w-full pl-4 pr-10 py-2.5 rounded-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 placeholder-purple-300 dark:placeholder-slate-500 border border-slate-200 dark:border-slate-800 text-xs focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-500/20 transition-all"
            />
            <button
              type="button"
              (click)="showNewPassword.set(!showNewPassword())"
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-purple-400 dark:text-slate-500 hover:text-purple-600"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>

          <div class="relative">
            <input
              [value]="confirmPassword()"
              (input)="confirmPassword.set($any($event.target).value)"
              [type]="showConfirmPassword() ? 'text' : 'password'"
              placeholder="Confirm New Password"
              required
              autocomplete="new-password"
              class="w-full pl-4 pr-10 py-2.5 rounded-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 placeholder-purple-300 dark:placeholder-slate-500 border border-slate-200 dark:border-slate-800 text-xs focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-500/20 transition-all"
            />
            <button
              type="button"
              (click)="showConfirmPassword.set(!showConfirmPassword())"
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-purple-400 dark:text-slate-500 hover:text-purple-600"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>

          @if (errorMessage()) {
            <div class="text-rose-500 dark:text-rose-400 text-xs text-center font-medium pt-1">{{ "{{" }} errorMessage() }}</div>
          }

          @if (successMessage()) {
            <div class="text-emerald-600 dark:text-emerald-400 text-xs text-center font-medium pt-1">{{ "{{" }} successMessage() }}</div>
          }

          <button
            type="submit"
            [disabled]="isSubmitting()"
            class="w-full py-3 bg-purple-700 hover:bg-purple-800 active:bg-purple-900 dark:bg-purple-800 dark:hover:bg-purple-700 text-white font-bold tracking-wider rounded-2xl transition-all text-xs uppercase disabled:opacity-50 shadow-md shadow-purple-600/20 dark:shadow-purple-900/30 cursor-pointer"
          >
            {{ "{{" }} isSubmitting() ? 'SAVING...' : 'SAVE NEW PASSWORD' }}
          </button>

          <div class="text-center pt-2">
            <a routerLink="/login" class="text-xs text-purple-700 dark:text-purple-400 font-bold hover:underline">Back to Login</a>
          </div>
        </form>
      }
    </div>
  `,
})
export class ForgotPasswordView implements OnInit {
  private readonly route = inject(ActivatedRoute)

  readonly isResetMode = signal(false)
  readonly email = signal('')
  readonly token = signal('')
  readonly newPassword = signal('')
  readonly confirmPassword = signal('')
  readonly showNewPassword = signal(false)
  readonly showConfirmPassword = signal(false)
  readonly isSubmitting = signal(false)
  readonly errorMessage = signal('')
  readonly successMessage = signal('')

  ngOnInit(): void {
    const queryToken = this.route.snapshot.queryParamMap.get('token')
    const queryEmail = this.route.snapshot.queryParamMap.get('email')

    if (queryToken && queryEmail) {
      this.isResetMode.set(true)
      this.token.set(queryToken)
      this.email.set(queryEmail)
    }
  }

  async handleRequestLink(event: Event) {
    event.preventDefault()
    this.errorMessage.set('')
    this.successMessage.set('')
    this.isSubmitting.set(true)

    try {
      const res = await api.post('/api/forgot-password', { email: this.email() })
      this.successMessage.set(res.data.message || 'A password reset link has been sent to your email.')
    } catch (err: any) {
      this.errorMessage.set(err.response?.data?.error || err.response?.data?.message || 'Failed to send the password reset email.')
    } finally {
      this.isSubmitting.set(false)
    }
  }

  async handleResetPassword(event: Event) {
    event.preventDefault()
    this.errorMessage.set('')
    this.successMessage.set('')

    if (this.newPassword() !== this.confirmPassword()) {
      this.errorMessage.set('Password confirmation does not match')
      return
    }

    this.isSubmitting.set(true)

    try {
      const res = await api.post('/api/reset-password', {
        email: this.email(),
        token: this.token(),
        new_password: this.newPassword(),
      })
      this.successMessage.set(res.data.message || 'Your password has been successfully updated. Please log in again.')
    } catch (err: any) {
      this.errorMessage.set(err.response?.data?.error || err.response?.data?.message || 'Failed to reset the password.')
    } finally {
      this.isSubmitting.set(false)
    }
  }
}
