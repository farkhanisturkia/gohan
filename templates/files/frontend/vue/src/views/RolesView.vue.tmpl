      </template>

    </div>

    <!-- Create / Edit Role Modal -->
    <div v-if="showModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-md flex items-center justify-center p-4 z-50">
      <div class="bg-white dark:bg-slate-900 border border-purple-100 dark:border-slate-800 rounded-3xl p-6 md:p-8 w-full max-w-md shadow-2xl relative overflow-hidden transition-colors duration-300">
        
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-bold text-purple-950 dark:text-purple-100">
            {{ "{{ isEditing ? 'Edit Role' : 'Add New Role' }}" }}
          </h3>
          <button @click="closeModal" class="text-purple-400 hover:text-purple-900 dark:hover:text-purple-200 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        
        <form @submit.prevent="handleSubmit" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-purple-900/70 dark:text-slate-400 mb-1.5">Role Name</label>
            <input 
              v-model="form.name" 
              type="text" 
              required 
              placeholder="e.g. admin, manager, user"
              class="w-full px-4 py-2.5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800 rounded-xl text-purple-950 dark:text-white placeholder-purple-300 dark:placeholder-slate-600 focus:outline-none focus:border-purple-600 dark:focus:border-purple-500 text-sm transition-all" 
            />
          </div>

          <div class="flex items-center justify-end space-x-3 pt-4">
            <button 
              type="button" 
              @click="closeModal" 
              class="px-5 py-2.5 bg-purple-50 dark:bg-slate-800 hover:bg-purple-100 dark:hover:bg-slate-700 text-purple-900 dark:text-slate-300 font-bold rounded-full text-xs transition-all cursor-pointer"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              :disabled="isSubmitting" 
              class="px-5 py-2.5 bg-purple-800 hover:bg-purple-900 dark:bg-purple-700 dark:hover:bg-purple-600 text-white font-bold rounded-full text-xs transition-all shadow-md uppercase tracking-wider cursor-pointer"
            >
              {{ "{{ submitBtnText }}" }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted } from 'vue'
import { useQuery, useMutation, useQueryClient } from '@tanstack/vue-query'
import api from '@/lib/axios'

interface Role {
  id: number
  name: string
}

const queryClient = useQueryClient()
const showModal = ref(false)
const isEditing = ref(false)
const editingRoleId = ref<number | null>(null)
const activeMenuId = ref<number | null>(null)

const form = ref({
  name: '',
})

// Toggle Dropdown Menu pada Mobile
const toggleActionMenu = (id: number) => {
  activeMenuId.value = activeMenuId.value === id ? null : id
}

const closeAllMenus = () => {
  activeMenuId.value = null
}

const handleEditFromMenu = (role: Role) => {
  closeAllMenus()
  openEditModal(role)
}

const handleDeleteFromMenu = (id: number) => {
  closeAllMenus()
  deleteRole(id)
}

// Global click listener untuk menutup dropdown saat klik luar
onMounted(() => {
  window.addEventListener('click', closeAllMenus)
})

onUnmounted(() => {
  window.removeEventListener('click', closeAllMenus)
})

// Open modal for Create
const openCreateModal = () => {
  isEditing.value = false
  editingRoleId.value = null
  form.value = { name: '' }
  showModal.value = true
}

// Open modal for Edit
const openEditModal = (role: Role) => {
  isEditing.value = true
  editingRoleId.value = role.id
  form.value = {
    name: role.name,
  }
  showModal.value = true
}

const closeModal = () => {
  showModal.value = false
}

// Fetch Roles
const { data: roles, isLoading, isError } = useQuery<Role[]>({
  queryKey: ['roles'],
  queryFn: async () => {
    const res = await api.get('/api/roles')
    return res.data.data.data ?? res.data.data
  },
})

// Create Role Mutation
const createMutation = useMutation({
  mutationFn: async (newRole: typeof form.value) => {
    await api.post('/api/roles', newRole)
  },
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['roles'] })
    closeModal()
  },
})

// Update Role Mutation
const updateMutation = useMutation({
  mutationFn: async ({ id, data }: { id: number; data: typeof form.value }) => {
    await api.put(`/api/roles/${id}`, data)
  },
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['roles'] })
    closeModal()
  },
})

const isSubmitting = computed(() => {
  return createMutation.isPending.value || updateMutation.isPending.value
})

const submitBtnText = computed(() => {
  if (isSubmitting.value) return 'Saving...'
  return isEditing.value ? 'Update Role' : 'Save Role'
})

const handleSubmit = () => {
  if (isEditing.value && editingRoleId.value) {
    updateMutation.mutate({ id: editingRoleId.value, data: form.value })
  } else {
    createMutation.mutate(form.value)
  }
}

// Delete Role Mutation
const deleteMutation = useMutation({
  mutationFn: async (id: number) => {
    await api.delete(`/api/roles/${id}`)
  },
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['roles'] })
  },
})

const deleteRole = (id: number) => {
  if (confirm('Are you sure you want to delete this role?')) {
    deleteMutation.mutate(id)
  }
}
</script>