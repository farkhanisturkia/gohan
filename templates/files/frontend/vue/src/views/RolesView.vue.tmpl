                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                  Edit
                </button>
                <button 
                  @click="handleDeleteFromMenu(r.id)"
                  class="w-full px-4 py-2 text-left text-xs font-bold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center gap-2 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  Delete
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- DESKTOP -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left text-sm text-purple-900/80 dark:text-slate-300">
            <thead class="bg-purple-50/70 dark:bg-slate-950/80 border-b border-purple-100 dark:border-slate-800 text-purple-950 dark:text-purple-300 uppercase text-[11px] font-bold tracking-wider">
              <tr>
                <th class="p-4 pl-6 w-24">ID</th>
                <th class="p-4">Role Name</th>
                <th class="p-4 pr-6 text-right w-36">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-purple-100/60 dark:divide-slate-800/80">
              <tr v-for="r in roles" :key="r.id" class="hover:bg-purple-50/40 dark:hover:bg-slate-800/40 transition-colors">
                <td class="p-4 pl-6 font-mono text-xs text-purple-400 dark:text-slate-500">#{{ "{{ r.id }}" }}</td>
                <td class="p-4 font-bold text-purple-950 dark:text-purple-100 capitalize">
                  <span class="px-3 py-1 bg-purple-100 dark:bg-purple-950/60 text-purple-800 dark:text-purple-300 border border-purple-200 dark:border-purple-800/50 rounded-full text-xs font-mono font-bold tracking-wider inline-block">
                    {{ "{{ r.name }}" }}
                  </span>
                </td>
                <td class="p-4 pr-6 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <button 
