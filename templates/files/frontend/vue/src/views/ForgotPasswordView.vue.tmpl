<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { useRoute } from 'vue-router'
import api from '@/lib/axios'

const route = useRoute()

const isResetMode = ref(false)
const email = ref('')
const token = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
const showNewPassword = ref(false)
const showConfirmPassword = ref(false)

const isSubmitting = ref(false)
const errorMessage = ref('')
const successMessage = ref('')

onMounted(() => {
  const queryToken = route.query.token as string
  const queryEmail = route.query.email as string

  if (queryToken && queryEmail) {
    isResetMode.value = true
    token.value = queryToken
    email.value = queryEmail
  }
})

const handleRequestLink = async () => {
  errorMessage.value = ''
  successMessage.value = ''
  isSubmitting.value = true

  try {
    const res = await api.post('/api/forgot-password', { email: email.value })
    successMessage.value = res.data.message || 'A password reset link has been sent to your email.'
  } catch (err: any) {
    errorMessage.value = err.response?.data?.error || err.response?.data?.message || 'Failed to send the password reset email.'
  } finally {
    isSubmitting.value = false
  }
}

const handleResetPassword = async () => {
  errorMessage.value = ''
  successMessage.value = ''

  if (newPassword.value !== confirmPassword.value) {
    errorMessage.value = 'Password confirmation does not match'
    return
  }

  isSubmitting.value = true

  try {
    const res = await api.post('/api/reset-password', {
      email: email.value,
      token: token.value,
      new_password: newPassword.value
    })
    successMessage.value = res.data.message || 'Your password has been successfully updated. Please log in again.'
  } catch (err: any) {
    errorMessage.value = err.response?.data?.error || err.response?.data?.message || 'Failed to reset the password.'
  } finally {
    isSubmitting.value = false
  }
}
</script>

<template>
  <div>
    <div class="text-center mb-6">
      <h2 class="text-xl font-black tracking-wide text-purple-950 dark:text-purple-300 uppercase">
        {{ "{{ isResetMode ? 'RESET PASSWORD' : 'FORGOT PASSWORD' }}" }}
      </h2>
      <p class="text-xs text-purple-600/80 dark:text-slate-400 mt-1 font-medium">
        {{ "{{ isResetMode ? 'Enter a new password for your account' : 'Enter your email address to receive a reset link' }}" }}
      </p>
    </div>

    <!-- FORM 1: Reset Email -->
    <form v-if="!isResetMode" @submit.prevent="handleRequestLink" class="space-y-4 max-w-sm mx-auto w-full">
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-purple-400 dark:text-slate-500">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
        </span>
        <input 
          v-model.trim="email" 
          type="email" 
          placeholder="Email Address" 
          required 
          autocomplete="email"
          class="w-full pl-10 pr-4 py-2.5 rounded-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 placeholder-purple-300 dark:placeholder-slate-500 border border-slate-200 dark:border-slate-800 text-xs focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-500/20 transition-all"
        />
      </div>

      <div v-if="errorMessage" class="text-rose-500 dark:text-rose-400 text-xs text-center font-medium pt-1">
        {{ "{{ errorMessage }}" }}
      </div>

      <div v-if="successMessage" class="text-emerald-600 dark:text-emerald-400 text-xs text-center font-medium pt-1">
        {{ "{{ successMessage }}" }}
      </div>

      <button 
        type="submit" 
        :disabled="isSubmitting"
        class="w-full py-3 bg-purple-700 hover:bg-purple-800 active:bg-purple-900 dark:bg-purple-800 dark:hover:bg-purple-700 text-white font-bold tracking-wider rounded-2xl transition-all text-xs uppercase disabled:opacity-50 shadow-md shadow-purple-600/20 dark:shadow-purple-900/30 cursor-pointer"
      >
        {{ "{{ isSubmitting ? 'SENDING LINK...' : 'SEND RESET LINK' }}" }}
      </button>

      <div class="text-center pt-2">
        <router-link to="/login" class="text-xs text-purple-700 dark:text-purple-400 font-bold hover:underline">
          Back to Login
        </router-link>
      </div>
    </form>

    <!-- FORM 2: New Password -->
    <form v-else @submit.prevent="handleResetPassword" class="space-y-4 max-w-sm mx-auto w-full">
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-purple-400 dark:text-slate-500">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
        </span>
        <input 
          v-model="newPassword" 
          :type="showNewPassword ? 'text' : 'password'" 
          placeholder="New Password" 
          required 
          autocomplete="new-password"
          class="w-full pl-10 pr-10 py-2.5 rounded-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 placeholder-purple-300 dark:placeholder-slate-500 border border-slate-200 dark:border-slate-800 text-xs focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-500/20 transition-all"
        />
        <button 
          type="button" 
          @click="showNewPassword = !showNewPassword"
          class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-purple-400 dark:text-slate-500 hover:text-purple-600 dark:hover:text-slate-300"
        >
          <svg v-if="!showNewPassword" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <svg v-else class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a8.959 8.959 0 013.122-.563c4.478 0 8.268 2.943 9.542 7a9.97 9.97 0 01-2.07 3.593m-5.495-2.261a3 3 0 11-4.243-4.243" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18" />
          </svg>
        </button>
      </div>

      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-purple-400 dark:text-slate-500">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
        </span>
        <input 
          v-model="confirmPassword" 
          :type="showConfirmPassword ? 'text' : 'password'" 
          placeholder="Confirm New Password" 
          required 
          autocomplete="new-password"
          class="w-full pl-10 pr-10 py-2.5 rounded-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 placeholder-purple-300 dark:placeholder-slate-500 border border-slate-200 dark:border-slate-800 text-xs focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-500/20 transition-all"
        />
        <button 
          type="button" 
          @click="showConfirmPassword = !showConfirmPassword"
          class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-purple-400 dark:text-slate-500 hover:text-purple-600 dark:hover:text-slate-300"
        >
          <svg v-if="!showConfirmPassword" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <svg v-else class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a8.959 8.959 0 013.122-.563c4.478 0 8.268 2.943 9.542 7a9.97 9.97 0 01-2.07 3.593m-5.495-2.261a3 3 0 11-4.243-4.243" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18" />
          </svg>
        </button>
      </div>

      <div v-if="errorMessage" class="text-rose-500 dark:text-rose-400 text-xs text-center font-medium pt-1">
        {{ "{{ errorMessage }}" }}
      </div>

      <div v-if="successMessage" class="text-emerald-600 dark:text-emerald-400 text-xs text-center font-medium pt-1">
        {{ "{{ successMessage }}" }}
      </div>

      <button 
        type="submit" 
        :disabled="isSubmitting"
        class="w-full py-3 bg-purple-700 hover:bg-purple-800 active:bg-purple-900 dark:bg-purple-800 dark:hover:bg-purple-700 text-white font-bold tracking-wider rounded-2xl transition-all text-xs uppercase disabled:opacity-50 shadow-md shadow-purple-600/20 dark:shadow-purple-900/30 cursor-pointer"
      >
        {{ "{{ isSubmitting ? 'SAVING...' : 'SAVE NEW PASSWORD' }}" }}
      </button>

      <div class="text-center pt-2">
        <router-link to="/login" class="text-xs text-purple-700 dark:text-purple-400 font-bold hover:underline">
          Back to Login
        </router-link>
      </div>
    </form>
  </div>
</template>