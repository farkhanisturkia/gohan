<script setup lang="ts">
{{- if .UseAuth }}
import { computed } from 'vue'
import { useAuth } from '@/composables/useAuth'

const { user } = useAuth()

const userDisplayName = computed(() => user.value ? user.value.name : 'User')
const userEmailDisplay = computed(() => user.value ? user.value.email : '-')
const userIdDisplay = computed(() => user.value ? user.value.id : '-')

{{- if .UseRole }}
const userRoleDisplay = computed(() => {
  if (!user.value || !user.value.role) return 'user'
  return typeof user.value.role === 'object' ? user.value.role.name : user.value.role
})
{{- end }}
{{- end }}
</script>