---
// Layout dasar: shell HTML + hydratasi App (client-side SPA).
import App from '@/App'
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = '{{ .ModuleName }} - Fullstack App' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="shortcut icon" href="#" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100">
    <App client:only="react" />
  </body>
</html>
