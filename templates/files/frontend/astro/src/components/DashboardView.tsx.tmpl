{{- if .UseAuth }}
import { useAuth } from '@/hooks/useAuth'
{{- end }}

export default function DashboardView() {
{{- if .UseAuth }}
  const { user } = useAuth()

  const userDisplayName = user ? user.name : 'User'
  const userEmailDisplay = user ? user.email : '-'
  const userIdDisplay = user ? user.id : '-'

{{- if .UseRole }}
  const userRoleDisplay = (() => {
    if (!user || !user.role) return 'user'
    return typeof user.role === 'object' ? user.role.name : user.role
  })()
{{- end }}
{{- end }}

  return (
    <div className="space-y-6 font-sans">
      {/* Welcome Header / Main Card */}
      <div className="bg-white dark:bg-slate-900 border border-purple-100 dark:border-slate-800 rounded-3xl p-6 md:p-8 shadow-2xl transition-colors duration-300 relative overflow-hidden">
        {/* Top Title & Badge */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div>
            <h2 className="text-2xl md:text-3xl font-bold text-purple-950 dark:text-purple-100 tracking-tight">
              Dashboard
            </h2>
            <p className="text-xs text-purple-400 dark:text-purple-400 mt-0.5 font-medium">Gohan Framework Control Panel</p>
          </div>

{{- if .UseAuth }}
          <span className="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500/10 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50 self-start sm:self-auto shadow-xs">
            <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Protected Area
          </span>
{{- end }}
        </div>

        <p className="text-purple-900/70 dark:text-slate-400 text-sm mb-6 leading-relaxed">
{{- if .UseAuth }}
          Welcome back, <strong className="text-purple-950 dark:text-purple-100 font-bold">{userDisplayName}</strong>! You have successfully authenticated using the
          <code className="text-purple-800 dark:text-purple-300 bg-purple-100/60 dark:bg-slate-950 px-2.5 py-1 rounded-full font-mono text-xs border border-purple-200 dark:border-slate-800 font-bold uppercase tracking-wider ml-1">{{ if eq .AuthType "jwt" }}JWT{{ else }}PAT{{ end }}</code> strategy.
{{- else }}
          Welcome to your Gohan Framework application panel!
{{- end }}
        </p>

{{- if .UseAuth }}
        {/* User Stats Cards Grid */}
        <div className="grid grid-cols-1 {{ if .UseRole }}md:grid-cols-3{{ else }}md:grid-cols-2{{ end }} gap-5 mt-6">
          {/* Card User ID */}
          <div className="p-5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800/80 rounded-2xl shadow-xs transition-all duration-300 hover:border-purple-300 dark:hover:border-purple-800">
            <div className="flex items-center justify-between mb-2">
              <span className="text-purple-400 dark:text-slate-500 text-xs font-bold uppercase tracking-wider">User ID</span>
              <div className="p-1.5 bg-purple-100 dark:bg-purple-900/40 rounded-lg text-purple-700 dark:text-purple-300">
                <svg className="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fillRule="evenodd" d="M10 2a1 1 0 00-1 1v1a1 1 0 002 0V3a1 1 0 00-1-1zM4 4a2 2 0 00-2 2v11a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm0 2h12v11H4V6z" clipRule="evenodd" />
                </svg>
              </div>
            </div>
            <div className="text-xl font-bold font-mono text-purple-950 dark:text-purple-100">{userIdDisplay}</div>
          </div>

          {/* Card Email */}
          <div className="p-5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800/80 rounded-2xl shadow-xs transition-all duration-300 hover:border-purple-300 dark:hover:border-purple-800">
            <div className="flex items-center justify-between mb-2">
              <span className="text-purple-400 dark:text-slate-500 text-xs font-bold uppercase tracking-wider">Email Address</span>
              <div className="p-1.5 bg-purple-100 dark:bg-purple-900/40 rounded-lg text-purple-700 dark:text-purple-300">
                <svg className="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                </svg>
              </div>
            </div>
            <div className="text-xl font-bold font-mono text-purple-950 dark:text-purple-100 truncate" title={userEmailDisplay}>{userEmailDisplay}</div>
          </div>

{{- if .UseRole }}
          {/* Card Role */}
          <div className="p-5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800/80 rounded-2xl shadow-xs transition-all duration-300 hover:border-purple-300 dark:hover:border-purple-800">
            <div className="flex items-center justify-between mb-2">
              <span className="text-purple-400 dark:text-slate-500 text-xs font-bold uppercase tracking-wider">Role / Access Level</span>
              <div className="p-1.5 bg-purple-100 dark:bg-purple-900/40 rounded-lg text-purple-700 dark:text-purple-300">
                <svg className="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fillRule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd" />
                </svg>
              </div>
            </div>
            <div className="text-xl font-bold font-mono text-purple-800 dark:text-purple-300 uppercase tracking-wider">{userRoleDisplay}</div>
          </div>
{{- end }}

        </div>
{{- end }}
      </div>
    </div>
  )
}
