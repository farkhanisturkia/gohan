import { useQuery } from '@tanstack/react-query'
import api from '@/lib/axios'

interface VersionResponse {
  message: string
  version: string
}

interface PingResponse {
  message: string
}

interface PublicResponse {
  result: string
}

{{- if .UseAuth }}
const authStrategy = '{{ if eq .AuthType "jwt" }}JWT{{ else }}PAT{{ end }}'
{{- end }}

// Fetch App Version
function useVersionQuery() {
  return useQuery<VersionResponse, Error>({
    queryKey: ['version'],
    queryFn: async () => {
      const res = await api.get('/version')
      return res.data
    },
  })
}

// Fetch Ping Status
function usePingQuery() {
  return useQuery<PingResponse, Error>({
    queryKey: ['ping'],
    queryFn: async () => {
      const res = await api.get('/ping')
      return res.data
    },
  })
}

// Fetch Public Status
function usePublicQuery() {
  return useQuery<PublicResponse, Error>({
    queryKey: ['check-public'],
    queryFn: async () => {
      const res = await api.get('/check-public')
      return res.data
    },
  })
}

function StatusBadge({ isLoading, isError, errorLabel }: { isLoading: boolean; isError: boolean; errorLabel: string }) {
  if (isLoading) {
    return (
      <span className="inline-flex items-center gap-1.5 text-[10px] text-amber-600 dark:text-amber-400 font-mono font-bold animate-pulse">
        Testing...
      </span>
    )
  }
  if (isError) {
    return (
      <span className="px-2 py-0.5 bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-800/50 rounded-full text-[10px] font-mono font-bold">
        {errorLabel}
      </span>
    )
  }
  return (
    <span className="px-2 py-0.5 bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50 rounded-full text-[10px] font-mono font-bold flex items-center gap-1">
      <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span> 200 OK
    </span>
  )
}

function EndpointCard({ method, path, isLoading, isError, display, errorLabel }: { method: string; path: string; isLoading: boolean; isError: boolean; display: string; errorLabel: string }) {
  return (
    <div className="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-4 space-y-3 flex flex-col justify-between shadow-sm dark:shadow-none">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2">
          <span className="px-2 py-0.5 bg-purple-700 dark:bg-purple-800/80 text-white rounded text-[10px] font-mono font-bold">{method}</span>
          <span className="text-xs font-mono font-semibold text-slate-800 dark:text-slate-200">{path}</span>
        </div>

        <StatusBadge isLoading={isLoading} isError={isError} errorLabel={errorLabel} />
      </div>

      <pre className="bg-slate-100 text-slate-800 border-slate-200 dark:bg-slate-900 dark:text-emerald-400 dark:border-slate-800 p-3 rounded-xl text-[11px] font-mono border overflow-x-auto max-h-36 leading-relaxed transition-colors duration-300">{display}</pre>
    </div>
  )
}

export default function HomeView() {
  const { data: versionData } = useVersionQuery()
  const { data: pingData, isLoading: pingLoading, error: pingError } = usePingQuery()
  const { data: publicData, isLoading: publicLoading, error: publicError } = usePublicQuery()

  const gohanVersion = versionData?.version ? `version ${versionData.version}` : 'version loading...'

  const pingDisplay = pingData
    ? JSON.stringify(pingData, null, 2)
    : pingError
      ? pingError.message
      : 'Fetching data...'

  const publicDisplay = publicData
    ? JSON.stringify(publicData, null, 2)
    : publicError
      ? publicError.message
      : 'Fetching data...'

  return (
    <div className="space-y-6">
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        {/* Framework Info & Hero */}
        <div className="lg:col-span-5 bg-white dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 md:p-8 flex flex-col justify-between space-y-6 shadow-sm dark:shadow-none backdrop-blur-sm transition-colors duration-300">
          <div className="space-y-4">
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800/50 text-purple-700 dark:text-purple-300 text-xs font-mono font-medium">
              <span className="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
              {gohanVersion}
            </div>

            <h2 className="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
              Gohan Framework
            </h2>

            <p className="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              A lightweight, fast, and structured Go fullstack ecosystem integrated with React, Tailwind CSS, and TanStack Query.
            </p>
          </div>

          <div className="pt-4">
            <a
              href="https://msroot.my.id"
              target="_blank"
              className="inline-flex items-center gap-2 px-6 py-3 bg-purple-700 hover:bg-purple-800 dark:bg-purple-800 dark:hover:bg-purple-700 text-white text-xs font-bold rounded-full uppercase tracking-wider transition-all shadow-md shadow-purple-200 dark:shadow-purple-900/30"
            >
              <span>Explore Documentation</span>
              <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          </div>
        </div>

        {/* Backend Connection Status */}
        <div className="lg:col-span-7 bg-white dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 md:p-8 flex flex-col justify-between space-y-6 shadow-sm dark:shadow-none backdrop-blur-sm transition-colors duration-300">
          <div className="space-y-6">
            {/* Header Backend Connection Status */}
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800/80 pb-4">
              <div className="space-y-1">
                <div className="flex items-center justify-between sm:justify-start gap-2">
                  <span className="px-2.5 py-0.5 bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/50 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider">
                    API Monitor
                  </span>
                </div>

                <h3 className="text-lg sm:text-xl font-bold text-slate-900 dark:text-white tracking-tight">
                  Backend Connection Status
                </h3>

                <p className="text-xs text-slate-500 dark:text-purple-400 font-mono leading-normal">
                  Testing live endpoints
                </p>
              </div>
            </div>

            {/* Cards Endpoint Status */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <EndpointCard method="GET" path="/ping" isLoading={pingLoading} isError={!!pingError} display={pingDisplay} errorLabel="Offline" />
              <EndpointCard method="GET" path="/check-public" isLoading={publicLoading} isError={!!publicError} display={publicDisplay} errorLabel="Failed" />
            </div>
          </div>
        </div>
      </div>

{{- if .UseAuth }}
      {/* Authentication Module Card */}
      <div className="bg-white dark:bg-slate-900/50 border border-purple-100 dark:border-purple-900/30 rounded-3xl p-6 md:p-8 flex items-center gap-5 shadow-sm dark:shadow-none backdrop-blur-sm transition-colors duration-300">
        <div className="w-12 h-12 rounded-2xl bg-purple-100 dark:bg-purple-900/60 border border-purple-200 dark:border-purple-700/50 flex items-center justify-center text-purple-700 dark:text-purple-300 shrink-0">
          <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <div>
          <h4 className="text-base font-bold text-slate-900 dark:text-white uppercase tracking-wider">Authentication Module</h4>
          <p className="text-xs text-slate-600 dark:text-slate-400 mt-1">
            Auth state is set up with
            <span className="px-2 py-0.5 bg-purple-100 dark:bg-purple-800/80 text-purple-700 dark:text-purple-200 border border-purple-200 dark:border-none rounded text-[11px] font-mono font-bold uppercase mx-1">
              {authStrategy}
            </span>
            token strategy and <code className="text-purple-700 dark:text-purple-300 font-mono font-semibold">js-cookie</code>.
          </p>
        </div>
      </div>
{{- end }}
    </div>
  )
}
