import { useEffect, useState } from 'react'
import { useQuery, useMutation, useQueryClient, keepPreviousData } from '@tanstack/react-query'
import api from '@/lib/axios'
import { usePagination } from '@/hooks/usePagination'

interface Role {
  id: number
  name: string
}

const emptyForm = { name: '' }

export default function RolesView() {
  const queryClient = useQueryClient()
  const [showModal, setShowModal] = useState(false)
  const [isEditing, setIsEditing] = useState(false)
  const [editingRoleId, setEditingRoleId] = useState<number | null>(null)
  const [activeMenuId, setActiveMenuId] = useState<number | null>(null)
  const [form, setForm] = useState(emptyForm)

  const { setPerPage, ...pagination } = usePagination()

  const toggleActionMenu = (id: number) => {
    setActiveMenuId(activeMenuId === id ? null : id)
  }

  const closeAllMenus = () => {
    setActiveMenuId(null)
  }

  useEffect(() => {
    window.addEventListener('click', closeAllMenus)
    return () => {
      window.removeEventListener('click', closeAllMenus)
    }
  }, [])

  // Open modal for Create
  const openCreateModal = () => {
    setIsEditing(false)
    setEditingRoleId(null)
    setForm({ ...emptyForm })
    setShowModal(true)
  }

  // Open modal for Edit
  const openEditModal = (role: Role) => {
    setIsEditing(true)
    setEditingRoleId(role.id)
    setForm({
      name: role.name,
    })
    setShowModal(true)
  }

  const closeModal = () => {
    setShowModal(false)
  }

  // Fetch Roles
  const { data: roles, isLoading, isError } = useQuery<Role[]>({
    queryKey: ['roles', pagination.currentPage, pagination.perPage],
    queryFn: async () => {
      const res = await api.get('/api/roles', { params: pagination.queryParams })
      return pagination.applyResponse(res.data.data)
    },
    placeholderData: keepPreviousData,
  })

  // Create Role Mutation
  const createMutation = useMutation({
    mutationFn: async (newRole: typeof emptyForm) => {
      await api.post('/api/roles', newRole)
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['roles'] })
      closeModal()
    },
  })

  // Update Role Mutation
  const updateMutation = useMutation({
    mutationFn: async ({ id, data }: { id: number; data: typeof emptyForm }) => {
      await api.put(`/api/roles/${id}`, data)
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['roles'] })
      closeModal()
    },
  })

  const isSubmitting = createMutation.isPending || updateMutation.isPending

  const submitBtnText = isSubmitting
    ? 'Saving...'
    : isEditing
      ? 'Update Role'
      : 'Save Role'

  const handleSubmit = () => {
    if (isEditing && editingRoleId) {
      updateMutation.mutate({ id: editingRoleId, data: form })
    } else {
      createMutation.mutate(form)
    }
  }

  // Delete Role Mutation
  const deleteMutation = useMutation({
    mutationFn: async (id: number) => {
      await api.delete(`/api/roles/${id}`)
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['roles'] })
    },
  })

  const deleteRole = (id: number) => {
    if (confirm('Are you sure you want to delete this role?')) {
      deleteMutation.mutate(id)
    }
  }

  return (
    <div className="space-y-6 font-sans">
      {/* Top Bar & Title */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 className="text-2xl md:text-3xl font-bold text-purple-950 dark:text-purple-100 tracking-tight">
            Roles Management
          </h2>
          <p className="text-xs text-purple-400 dark:text-purple-400 mt-0.5 font-medium">Manage your role data</p>
        </div>

        <button
          onClick={openCreateModal}
          className="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-purple-800 hover:bg-purple-900 dark:bg-purple-700 dark:hover:bg-purple-600 text-white font-bold rounded-full text-xs transition-all shadow-md hover:shadow-purple-900/20 uppercase tracking-wider cursor-pointer self-start sm:self-auto"
        >
          <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4v16m8-8H4"></path></svg>
          Add Role
        </button>
      </div>

      {/* Roles Container Card */}
      <div className="bg-white dark:bg-slate-900 border border-purple-100 dark:border-slate-800 rounded-3xl shadow-2xl overflow-hidden transition-colors duration-300">
        {/* STATE: Loading & Error */}
        {isLoading && (
          <div className="p-8 text-center text-purple-400 dark:text-slate-500 font-medium">
            <div className="flex items-center justify-center gap-2">
              <svg className="w-4 h-4 animate-spin text-purple-700 dark:text-purple-400" fill="none" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
              Loading roles...
            </div>
          </div>
        )}
        {isError && (
          <div className="p-8 text-center text-rose-500 font-medium">
            Failed to load roles list.
          </div>
        )}

        {!isLoading && !isError && (
          <>
            {/* MOBILE */}
            <div className="block md:hidden divide-y divide-purple-100/60 dark:divide-slate-800/80">
              {roles?.map((r) => (
                <div
                  key={r.id}
                  className="p-4 flex items-center justify-between gap-3 hover:bg-purple-50/30 dark:hover:bg-slate-800/30 transition-colors"
                >
                  <div className="min-w-0 flex-1 space-y-1">
                    <div className="flex items-center gap-2">
                      <span className="font-mono text-[10px] text-purple-400 dark:text-slate-500">#{r.id}</span>
                      <h3 className="font-bold text-sm text-purple-950 dark:text-purple-100 truncate capitalize">{r.name}</h3>
                    </div>
                  </div>

                  <div className="relative shrink-0">
                    <button
                      onClick={(e) => { e.stopPropagation(); toggleActionMenu(r.id) }}
                      className="p-2 text-slate-400 hover:text-purple-900 dark:hover:text-purple-200 rounded-full hover:bg-purple-50 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                    >
                      {/* Kebab Icon */}
                      <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                      </svg>
                    </button>

                    {activeMenuId === r.id && (
                      <div
                        className="absolute right-0 mt-1 w-32 bg-white dark:bg-slate-800 border border-purple-100 dark:border-slate-700 rounded-2xl shadow-xl z-20 py-1.5 transition-all overflow-hidden"
                      >
                        <button
                          onClick={() => { closeAllMenus(); openEditModal(r) }}
                          className="w-full px-4 py-2 text-left text-xs font-bold text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/40 flex items-center gap-2 cursor-pointer"
                        >
                          <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                          Edit
                        </button>
                        <button
                          onClick={() => { closeAllMenus(); deleteRole(r.id) }}
                          className="w-full px-4 py-2 text-left text-xs font-bold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center gap-2 cursor-pointer"
                        >
                          <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                          Delete
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>

            {/* DESKTOP */}
            <div className="hidden md:block overflow-x-auto">
              <table className="w-full text-left text-sm text-purple-900/80 dark:text-slate-300">
                <thead className="bg-purple-50/70 dark:bg-slate-950/80 border-b border-purple-100 dark:border-slate-800 text-purple-950 dark:text-purple-300 uppercase text-[11px] font-bold tracking-wider">
                  <tr>
                    <th className="p-4 pl-6 w-24">ID</th>
                    <th className="p-4">Name</th>
                    <th className="p-4 pr-6 text-right w-36">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-purple-100/60 dark:divide-slate-800/80">
                  {roles?.map((r) => (
                    <tr key={r.id} className="hover:bg-purple-50/40 dark:hover:bg-slate-800/40 transition-colors">
                      <td className="p-4 pl-6 font-mono text-xs text-purple-400 dark:text-slate-500">#{r.id}</td>
                      <td className="p-4 font-bold text-purple-950 dark:text-purple-100 capitalize">{r.name}</td>
                      <td className="p-4 pr-6 text-right">
                        <div className="flex items-center justify-end gap-1.5">
                          <button
                            onClick={() => openEditModal(r)}
                            title="Edit Role"
                            className="p-2 text-amber-600 dark:text-amber-400 hover:bg-amber-100/80 dark:hover:bg-amber-950/50 rounded-xl transition-all cursor-pointer"
                          >
                            <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                          </button>

                          <button
                            onClick={() => deleteRole(r.id)}
                            title="Delete Role"
                            className="p-2 text-rose-600 dark:text-rose-400 hover:bg-rose-100/80 dark:hover:bg-rose-950/50 rounded-xl transition-all cursor-pointer"
                          >
                            <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Pagination */}
            {pagination.totalItems > 0 && (
              <div className="border-t border-purple-100 dark:border-slate-800 px-4 py-4 bg-purple-50/30 dark:bg-slate-950/40">
                <div className="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 flex-wrap">
                  <span className="text-xs text-purple-900/60 dark:text-slate-500 font-medium">
                    Showing {roles?.length ?? 0} of {pagination.totalItems} roles
                  </span>

                  <div className="flex items-center gap-1.5">
                    <button
                      onClick={() => pagination.changePage(pagination.currentPage - 1)}
                      disabled={pagination.currentPage <= 1}
                      className="px-3 py-1.5 text-xs font-bold rounded-full border border-purple-200 dark:border-slate-700 text-purple-800 dark:text-purple-300 bg-white dark:bg-slate-900 hover:bg-purple-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer"
                    >
                      Prev
                    </button>

                    {pagination.paginationPages().map((p, idx) =>
                      p === '...' ? (
                        <span key={`ellipsis-${idx}`} className="px-1 text-xs text-purple-400 dark:text-slate-600 font-bold">…</span>
                      ) : (
                        <button
                          key={`page-${idx}`}
                          onClick={() => pagination.changePage(Number(p))}
                          className={`min-w-8 px-2 py-1.5 text-xs font-bold rounded-full border transition-all cursor-pointer ${
                            p === pagination.currentPage
                              ? 'bg-purple-800 dark:bg-purple-700 text-white border-purple-800 dark:border-purple-700 shadow-md'
                              : 'bg-white dark:bg-slate-900 text-purple-800 dark:text-purple-300 border-purple-200 dark:border-slate-700 hover:bg-purple-100 dark:hover:bg-slate-800'
                          }`}
                        >
                          {p}
                        </button>
                      )
                    )}

                    <button
                      onClick={() => pagination.changePage(pagination.currentPage + 1)}
                      disabled={pagination.currentPage >= pagination.lastPage}
                      className="px-3 py-1.5 text-xs font-bold rounded-full border border-purple-200 dark:border-slate-700 text-purple-800 dark:text-purple-300 bg-white dark:bg-slate-900 hover:bg-purple-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer"
                    >
                      Next
                    </button>
                  </div>

                  <label className="flex items-center gap-2 text-xs text-purple-900/60 dark:text-slate-500 font-medium">
                    Per page
                    <select
                      value={pagination.perPage}
                      onChange={(e) => setPerPage(Number(e.target.value))}
                      className="px-2 py-1.5 bg-white dark:bg-slate-900 border border-purple-200 dark:border-slate-700 rounded-full text-xs font-bold text-purple-800 dark:text-purple-300 focus:outline-none focus:border-purple-600 dark:focus:border-purple-500 cursor-pointer"
                    >
                      {pagination.perPageOptions.map((opt) => (
                        <option key={opt} value={opt}>{opt}</option>
                      ))}
                    </select>
                  </label>
                </div>
              </div>
            )}
          </>
        )}
      </div>

      {/* Create / Edit Role Modal */}
      {showModal && (
        <div className="fixed inset-0 bg-slate-950/60 backdrop-blur-md flex items-center justify-center p-4 z-50">
          <div className="bg-white dark:bg-slate-900 border border-purple-100 dark:border-slate-800 rounded-3xl p-6 md:p-8 w-full max-w-md shadow-2xl relative overflow-hidden transition-colors duration-300">
            <div className="flex items-center justify-between mb-6">
              <h3 className="text-xl font-bold text-purple-950 dark:text-purple-100">
                {isEditing ? 'Edit Role' : 'Add New Role'}
              </h3>
              <button onClick={closeModal} className="text-purple-400 hover:text-purple-900 dark:hover:text-purple-200 transition-colors">
                <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>

            <form onSubmit={(e) => { e.preventDefault(); handleSubmit() }} className="space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase tracking-wider text-purple-900/70 dark:text-slate-400 mb-1.5">Name</label>
                <input
                  value={form.name}
                  onChange={(e) => setForm({ ...form, name: e.target.value.trim() })}
                  type="text"
                  required
                  placeholder="e.g. admin, manager, user"
                  className="w-full px-4 py-2.5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800 rounded-xl text-purple-950 dark:text-white placeholder-purple-300 dark:placeholder-slate-600 focus:outline-none focus:border-purple-600 dark:focus:border-purple-500 text-sm transition-all"
                />
              </div>

              <div className="flex items-center justify-end space-x-3 pt-4">
                <button
                  type="button"
                  onClick={closeModal}
                  className="px-5 py-2.5 bg-purple-50 dark:bg-slate-800 hover:bg-purple-100 dark:hover:bg-slate-700 text-purple-900 dark:text-slate-300 font-bold rounded-full text-xs transition-all cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={isSubmitting}
                  className="px-5 py-2.5 bg-purple-800 hover:bg-purple-900 dark:bg-purple-700 dark:hover:bg-purple-600 text-white font-bold rounded-full text-xs transition-all shadow-md uppercase tracking-wider cursor-pointer"
                >
                  {submitBtnText}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  )
}
