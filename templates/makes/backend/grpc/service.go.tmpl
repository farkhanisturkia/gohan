type {{ .Prefix }}Service struct {
    db *gohan.DB
}

func New{{ .Prefix }}Service(db *gohan.DB) *{{ .Prefix }}Service {
    return &{{ .Prefix }}Service{db: db}
}

func (s *{{ .Prefix }}Service) List{{ .Prefix }}s(ctx context.Context, req *gohan.Request[{{ .Prefix | toSnake }}v1.List{{ .Prefix }}sRequest]) (*gohan.Response[{{ .Prefix | toSnake }}v1.List{{ .Prefix }}sResponse], error) {
    page := int(req.Msg.Page)
    if page <= 0 {
        page = 1
    }

    perPage := int(req.Msg.PerPage)
    if perPage <= 0 {
        perPage = 10
    }

    var items []migrations.{{ .Prefix }}
    res, err := s.db.Paginate(page, perPage).Find(&items)
    if err != nil {
        return nil, gohan.NewError(gohan.CodeInternal, errors.New("Failed to fetch {{ .Prefix }} data: "+err.Error()))
    }

    lastPage := int32(1)
    if res.Total > 0 && perPage > 0 {
        lastPage = int32((res.Total + int64(perPage) - 1) / int64(perPage))
    }

    protoItems := make([]*{{ .Prefix | toSnake }}v1.{{ .Prefix }}, 0, len(items))
    for _, item := range items {
        protoItems = append(protoItems, {{ toCamel .Prefix }}ToProto(item))
    }

    return gohan.NewResponse(&{{ .Prefix | toSnake }}v1.List{{ .Prefix }}sResponse{
        Message:     "Fetch {{ .Prefix }} list successful",
        Data:        protoItems,
        Total:       res.Total,
        PerPage:     int32(perPage),
        CurrentPage: int32(page),
        LastPage:    lastPage,
    }), nil
}

func (s *{{ .Prefix }}Service) Create{{ .Prefix }}(ctx context.Context, req *gohan.Request[{{ .Prefix | toSnake }}v1.Create{{ .Prefix }}Request]) (*gohan.Response[{{ .Prefix | toSnake }}v1.Create{{ .Prefix }}Response], error) {
    in := req.Msg

    if in.Name == "" {
        return nil, gohan.NewError(gohan.CodeInvalidArgument, errors.New("Invalid request or missing required field (name)"))
    }

    item := migrations.{{ .Prefix }}{
        Name: in.Name,
    }

    if err := s.db.Transaction(func(tx *gohan.Tx) error {
        return tx.Create(&item)
    }); err != nil {
        return nil, gohan.NewError(gohan.CodeInternal, errors.New("Failed to create {{ .Prefix }}"))
    }

{{- if .UseRedis }}
    s.clear{{ .Prefix }}Cache(ctx)
{{- end }}

    return gohan.NewResponse(&{{ .Prefix | toSnake }}v1.Create{{ .Prefix }}Response{
        Message: "{{ .Prefix }} created successfully",
        Data:    {{ toCamel .Prefix }}ToProto(item),
    }), nil
}

