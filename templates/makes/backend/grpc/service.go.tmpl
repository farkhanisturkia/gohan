    }

    return gohan.NewResponse(&{{ .Prefix | toSnake }}v1.Get{{ .Prefix }}Response{
        Message: "Fetch {{ .Prefix }} detail successful",
        Data:    {{ toCamel .Prefix }}ToProto(item),
