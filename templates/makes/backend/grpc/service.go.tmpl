    in := req.Msg
    id := int(in.Id)

    var item migrations.{{ .Prefix }}
    if err := s.db.FindOne(&item, "id = ?", id); err != nil {
        if gohan.IsNotFound(err) {
            return nil, gohan.NewError(gohan.CodeNotFound, errors.New("{{ .Prefix }} not found"))
        }
        return nil, gohan.NewError(gohan.CodeInternal, errors.New("Failed to fetch {{ .Prefix }} detail: "+err.Error()))
    }

    if in.Name != "" {
        item.Name = in.Name
    }

    if err := s.db.Transaction(func(tx *gohan.Tx) error {
