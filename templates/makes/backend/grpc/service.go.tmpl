func {{ toCamel .Prefix }}ToProto(item migrations.{{ .Prefix }}) *{{ .Prefix | toSnake }}v1.{{ .Prefix }} {
    return &{{ .Prefix | toSnake }}v1.{{ .Prefix }}{
        Id:        int32(item.ID),
        Name:      item.Name,
        CreatedAt: item.CreatedAt.Format(time.RFC3339),
    }
}
{{- if .UseRedis }}

func (s *{{ .Prefix }}Service) clear{{ .Prefix }}Cache(ctx context.Context, extraKeys ...string) {
    for _, key := range extraKeys {
        gohan.CacheForget(ctx, gohan.Redis, key)
    }

    iter := gohan.Redis.Scan(ctx, 0, "crud:{{ .Prefix | toKebab }}:*", 0).Iterator()
    for iter.Next(ctx) {
        gohan.CacheForget(ctx, gohan.Redis, iter.Val())
    }
}
