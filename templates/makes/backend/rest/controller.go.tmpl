package controllers

import (
{{- if .UseRedis }}
    "fmt"
    "time"
{{- end }}
    "net/http"
	"strconv"

    "github.com/farkhanisturkia/gohan/pkg"
    "{{ .ModuleName }}/database/migrations"
)

type Create{{.Prefix}}Request struct {
    Name string `json:"name"`
}

type Update{{.Prefix}}Request struct {
    Name string `json:"name"`
}

func {{.Prefix}}Index(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
		page, _ := strconv.Atoi(r.URL.Query().Get("page"))
		if page <= 0 {
			page = 1
		}

		perPage, _ := strconv.Atoi(r.URL.Query().Get("per_page"))
		if perPage <= 0 {
			perPage = 10
		}

        var items []migrations.{{.Prefix}}
{{- if .UseRedis }}
		var paginationData gohan.Pagination
        cacheKey := fmt.Sprintf("%s:all:page:%d:limit:%d", "{{ .Prefix | toLower }}", page, perPage)

		if cachedData, err := gohan.Redis.Get(r.Context(), cacheKey).Result(); err == nil && cachedData != "" {
			if err := gohan.Unmarshal([]byte(cachedData), &paginationData); err == nil {
				gohan.JSON(w, http.StatusOK, map[string]interface{}{
					"message": "Fetch Role list successful (cached)",
					"data":    paginationData,
				})
				return
			}
		}
{{- end }}

		res, err := db.Paginate(page, perPage).Find(&items)
		if err != nil {
			gohan.JSON(w, http.StatusInternalServerError, map[string]string{
				"message": "Failed to fetch {{.Prefix}} data: " + err.Error(),
			})
			return
		}

{{- if .UseRedis }}
        if jsonBytes, err := gohan.Marshal(items); err == nil {
            _ = gohan.Redis.Set(r.Context(), cacheKey, string(jsonBytes), 10*time.Minute).Err()
        }
{{- end }}

        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Fetch {{.Prefix}} list successful",
            "data":    res,
        })
    }
}

func {{.Prefix}}Create(_ *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Create {{.Prefix}} form / view",
        })
    }
}

func {{.Prefix}}Store(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        var req Create{{.Prefix}}Request
        if err := gohan.BindJSON(r, &req); err != nil {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{
                "message": "Invalid request body",
            })
            return
        }

        item := migrations.{{.Prefix}}{
            Name: req.Name,
        }

        err := db.Transaction(func(tx *gohan.Tx) error {
            return tx.Create(&item)
        })

        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to create {{.Prefix}}",
            })
            return
        }

{{- if .UseRedis }}
        _ = gohan.Redis.Del(r.Context(), "{{.Prefix | toLower}}:all").Err()
{{- end }}

        gohan.JSON(w, http.StatusCreated, map[string]interface{}{
            "message": "{{.Prefix}} created successfully",
            "data":    item,
        })
    }
}

func {{.Prefix}}Show(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        id := gohan.Param(r, "id")
        var item migrations.{{.Prefix}}

{{- if .UseRedis }}
        cacheKey := fmt.Sprintf("{{.Prefix | toLower}}:%s", id)
        if cachedData, err := gohan.Redis.Get(r.Context(), cacheKey).Result(); err == nil && cachedData != "" {
            if err := gohan.Unmarshal([]byte(cachedData), &item); err == nil {
                gohan.JSON(w, http.StatusOK, map[string]interface{}{
                    "message": "Fetch {{.Prefix}} detail successful (cached)",
                    "data":    item,
                })
                return
            }
        }
{{- end }}

        if err := db.FindOne(&item, "id = ?", id); err != nil {
            gohan.JSON(w, http.StatusNotFound, map[string]string{
                "message": "{{.Prefix}} not found",
            })
            return
        }

{{- if .UseRedis }}
        if jsonBytes, err := gohan.Marshal(item); err == nil {
            _ = gohan.Redis.Set(r.Context(), cacheKey, string(jsonBytes), 10*time.Minute).Err()
        }
{{- end }}

        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Fetch {{.Prefix}} detail successful",
            "data":    item,
        })
    }
}

