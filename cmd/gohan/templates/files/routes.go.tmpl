    //         gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": err.Error()})
    //         return
    //     }

    //     gohan.JSON(w, http.StatusOK, responseData)
    // })

    // Post API public wih custom headers
    // gohan.Get("/public-data", func(w http.ResponseWriter, r *http.Request) {
    //     headers := map[string]string{
    //         "Authorization": "Bearer YOUR_PUBLIC_API_KEY",
    //         "User-Agent":    "GohanApp/1.0",
    //     }

    //     var result map[string]interface{}

    //     err := gohan.NewHTTPClient(10 * time.Second).Request(
    //         "GET", 
    //         "https://api.example.com/v1/resources", 
    //         nil, 
    //         headers, 
    //         &result,
    //     )

    //     if err != nil {
    //         gohan.JSON(w, http.StatusBadGateway, map[string]string{"error": err.Error()})
    //         return
    //     }

    //     gohan.JSON(w, http.StatusOK, result)
    // })
{{- if .UseAuth }}

    // Authentication Routes
    gohan.Post("/api/login", controllers.LoginAuth(db))
    gohan.Post("/api/logout", middleware.Authenticate(db, controllers.LogoutAuth(db)))

    gohan.Get("/api/me", middleware.Authenticate(db, func(w http.ResponseWriter, r *http.Request) {
        user, ok := middleware.GetAuthUser(r)
        if !ok {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to get user context",
            })
            return
        }

        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "User profile retrieved successfully",
            "data": map[string]interface{}{
                "id":    user.ID,
                "name":  user.Name,
                "email": user.Email,
{{- if .UseRole }}
                "role":  user.Role,
{{- end }}
            },
        })
    }))
{{- if .UseRole }}

    // Example Role-Based Protected Routes
    gohan.Get("/api/admin/dashboard", middleware.Authenticate(db, middleware.RequireRole([]string{"admin"}, func(w http.ResponseWriter, r *http.Request) {
        gohan.JSON(w, http.StatusOK, map[string]string{
            "message": "Welcome to Admin Dashboard",
        })
    })))
{{- end }}
{{- end }}
{{- if and .UseAuth .UseForgotPassword }}

    // Password Reset Routes
    gohan.Post("/api/forgot-password", controllers.ForgotPassword(db))
    gohan.Post("/api/reset-password", controllers.ResetPassword(db))
{{- end }}
}