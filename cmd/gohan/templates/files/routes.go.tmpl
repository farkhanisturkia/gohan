func SetupRoutes(db *gohan.DB) {
    // Public Health Check Route
    gohan.Get("/ping", func(w http.ResponseWriter, r *http.Request) {
        gohan.JSON(w, http.StatusOK, map[string]string{
            "message": "pong",
        })
    })

    // Get API public
    gohan.Get("/check-public", func(w http.ResponseWriter, r *http.Request) {
        var textResult string

        err := gohan.FetchJSON("https://api.github.com/zen", &textResult)
        if err != nil {
            gohan.JSON(w, http.StatusBadGateway, map[string]string{
                "message": "Failed to connect to the Public API",
                "error":   err.Error(),
            })
            return
        }

        gohan.JSON(w, http.StatusOK, map[string]string{
            "result": textResult,
        })
    })

    // Post API public
