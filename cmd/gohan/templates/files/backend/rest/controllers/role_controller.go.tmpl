package controllers

import (
    "net/http"
    "strconv"
{{- if .UseRedis }}
    "fmt"
    "context"
    "time"
{{- end }}

    "github.com/farkhanisturkia/gohan"
    "{{ .ModuleName }}/database/migrations"
)

type CreateRoleRequest struct {
    Name string `json:"name"`
}

type UpdateRoleRequest struct {
    Name string `json:"name"`
}

func RoleIndex(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        page, _ := strconv.Atoi(r.URL.Query().Get("page"))
        if page <= 0 {
            page = 1
        }

        perPage, _ := strconv.Atoi(r.URL.Query().Get("per_page"))
        if perPage <= 0 {
            perPage = 10
        }

        var items []migrations.Role
{{- if .UseRedis }}
        var paginationData gohan.Pagination
        cacheKey := fmt.Sprintf("role:all:page:%d:limit:%d", page, perPage)

        if cachedData, err := gohan.Redis.Get(r.Context(), cacheKey).Result(); err == nil && cachedData != "" {
            if err := gohan.Unmarshal([]byte(cachedData), &paginationData); err == nil {
                gohan.JSON(w, http.StatusOK, map[string]interface{}{
                    "message": "Fetch Role list successful (cached)",
                    "data":    paginationData,
                })
                return
            }
        }

{{- end }}
        res, err := db.Paginate(page, perPage).Find(&items)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to fetch Role data: " + err.Error(),
            })
            return
        }

{{- if .UseRedis }}
        if jsonBytes, err := gohan.Marshal(res); err == nil {
            _ = gohan.Redis.Set(r.Context(), cacheKey, string(jsonBytes), 10*time.Minute).Err()
        }

{{- end }}
        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Fetch Role list successful",
            "data":    res,
        })
    }
}

func RoleCreate(_ *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Create Role form / view",
        })
    }
}

func RoleStore(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        var req CreateRoleRequest
        if err := gohan.BindJSON(r, &req); err != nil || req.Name == "" {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{
                "message": "Invalid request body or missing required field (name)",
            })
            return
        }

        item := migrations.Role{
            Name: req.Name,
        }

        err := db.Transaction(func(tx *gohan.Tx) error {
            return tx.Create(&item)
        })

        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to create Role",
            })
            return
        }

{{- if .UseRedis }}
        clearRoleCache(r.Context())

{{- end }}
        gohan.JSON(w, http.StatusCreated, map[string]interface{}{
            "message": "Role created successfully",
            "data":    item,
        })
    }
}

func RoleShow(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        id := gohan.Param(r, "id")
        var item migrations.Role
{{- if .UseRedis }}
        cacheKey := fmt.Sprintf("role:%s", id)

        if cachedData, err := gohan.Redis.Get(r.Context(), cacheKey).Result(); err == nil && cachedData != "" {
            if err := gohan.Unmarshal([]byte(cachedData), &item); err == nil {
                gohan.JSON(w, http.StatusOK, map[string]interface{}{
                    "message": "Fetch Role detail successful (cached)",
                    "data":    item,
                })
                return
            }
        }

{{- end }}
        if err := db.FindOne(&item, "id = ?", id); err != nil {
            gohan.JSON(w, http.StatusNotFound, map[string]string{
                "message": "Role not found",
            })
            return
        }

{{- if .UseRedis }}
        if jsonBytes, err := gohan.Marshal(item); err == nil {
            _ = gohan.Redis.Set(r.Context(), cacheKey, string(jsonBytes), 10*time.Minute).Err()
        }

{{- end }}
        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Fetch Role detail successful",
            "data":    item,
        })
    }
}

