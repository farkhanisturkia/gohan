func UserUpdate(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        id := gohan.Param(r, "id")

        var req UpdateUserRequest
        if err := gohan.BindJSON(r, &req); err != nil {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{
                "message": "Invalid request body",
            })
            return
        }

        var item migrations.User
        if err := db.FindOne(&item, "id = ?", id); err != nil {
            gohan.JSON(w, http.StatusNotFound, map[string]string{
                "message": "User not found",
            })
            return
        }

        if req.Name != "" {
            item.Name = req.Name
        }
        if req.Email != "" {
            item.Email = req.Email
        }
{{- if .UseRole }}
        if req.RoleID != 0 {
            item.RoleID = req.RoleID
        }
{{- end }}

        err := db.Transaction(func(tx *gohan.Tx) error {
            return tx.Update(&item, id)
        })

        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to update User",
            })
            return
        }

{{- if .UseRole }}
        _ = db.Preload("Role").FindOne(&item, "id = ?", id)
{{- end }}

{{- if .UseRedis }}
        clearUserCache(r.Context(), fmt.Sprintf("user:%s", id))

{{- end }}
        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "User updated successfully",
            "data":    item,
        })
    }
}

func UserDestroy(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        id := gohan.Param(r, "id")

        var item migrations.User
        if err := db.FindOne(&item, "id = ?", id); err != nil {
            gohan.JSON(w, http.StatusNotFound, map[string]string{
                "message": "User not found",
            })
            return
        }

        err := db.Transaction(func(tx *gohan.Tx) error {
            return tx.Delete(&migrations.User{}, id)
        })

        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to delete User",
            })
            return
        }

{{- if .UseRedis }}
        clearUserCache(r.Context(), fmt.Sprintf("user:%s", id))

{{- end }}
        gohan.JSON(w, http.StatusOK, map[string]string{
            "message": "User deleted successfully",
        })
    }
}
{{- if .UseRedis }}

func clearUserCache(ctx context.Context, extraKeys ...string) {
    for _, key := range extraKeys {
        _ = gohan.Redis.Del(ctx, key).Err()
    }

    iter := gohan.Redis.Scan(ctx, 0, "user:all*", 0).Iterator()
    for iter.Next(ctx) {
        _ = gohan.Redis.Del(ctx, iter.Val()).Err()
    }
}
{{- end }}