package controllers

import (
    "fmt"
    "net/http"
    "strconv"
{{- if .UseRedis }}
    "context"
    "time"
{{- end }}

    "github.com/farkhanisturkia/gohan"
    "{{ .ModuleName }}/database/migrations"
)

type CreateUserRequest struct {
    Name     string `json:"name"`
    Email    string `json:"email"`
    Password string `json:"password"`
{{- if .UseRole }}
    RoleID   int    `json:"role_id"`
{{- end }}
}

type UpdateUserRequest struct {
    Name   string `json:"name"`
    Email  string `json:"email"`
{{- if .UseRole }}
    RoleID int    `json:"role_id"`
{{- end }}
}

func UserIndex(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        page, _ := strconv.Atoi(r.URL.Query().Get("page"))
        if page <= 0 {
            page = 1
        }

        perPage, _ := strconv.Atoi(r.URL.Query().Get("per_page"))
        if perPage <= 0 {
            perPage = 10
        }

        var items []migrations.User
{{- if .UseRedis }}
        var paginationData gohan.Pagination
        cacheKey := fmt.Sprintf("user:all:page:%d:limit:%d", page, perPage)

        if cachedData, err := gohan.Redis.Get(r.Context(), cacheKey).Result(); err == nil && cachedData != "" {
            if err := gohan.Unmarshal([]byte(cachedData), &paginationData); err == nil {
                gohan.JSON(w, http.StatusOK, map[string]interface{}{
                    "message": "Fetch User list successful (cached)",
                    "data":    paginationData,
                })
                return
            }
        }

{{- end }}
{{- if .UseRole }}
        res, err := db.Paginate(page, perPage).Preload("Role").Find(&items)
{{- else }}
        res, err := db.Paginate(page, perPage).Find(&items)
{{- end }}
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to fetch User data: " + err.Error(),
            })
            return
        }

{{- if .UseRedis }}
        if jsonBytes, err := gohan.Marshal(res); err == nil {
            _ = gohan.Redis.Set(r.Context(), cacheKey, string(jsonBytes), 10*time.Minute).Err()
        }

{{- end }}
        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Fetch User list successful",
            "data":    res,
        })
    }
}

func UserCreate(_ *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Create User form / view",
        })
    }
}

func UserStore(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        var req CreateUserRequest
        if err := gohan.BindJSON(r, &req); err != nil || req.Email == "" || req.Password == "" {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{
                "message": "Invalid request body or missing required fields (email/password)",
            })
            return
        }

        hashedPassword, err := gohan.HashPassword(req.Password)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to process security credentials",
            })
            return
        }

        item := migrations.User{
            Name:     req.Name,
            Email:    req.Email,
            Password: hashedPassword,
{{- if .UseRole }}
            RoleID:   req.RoleID,
{{- end }}
        }

        err = db.Transaction(func(tx *gohan.Tx) error {
            return tx.Create(&item)
        })

        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": "Failed to create User",
            })
            return
        }

{{- if .UseRole }}
        _ = db.Preload("Role").FindOne(&item, "id = ?", item.ID)
{{- end }}

{{- if .UseRedis }}
        clearUserCache(r.Context())

{{- end }}
        gohan.JSON(w, http.StatusCreated, map[string]interface{}{
            "message": "User created successfully",
            "data":    item,
        })
    }
}

