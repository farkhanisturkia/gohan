package controllers

import (
    "fmt"
    "net/http"
    "time"

    "github.com/farkhanisturkia/gohan"
    "{{ .ModuleName }}/database/migrations"
)

type ForgotPasswordRequest struct {
    Email string `json:"email"`
}

type ResetPasswordRequest struct {
    Email       string `json:"email"`
    Token       string `json:"token"`
    NewPassword string `json:"new_password"`
}

func ForgotPassword(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        var req ForgotPasswordRequest
        if err := gohan.BindJSON(r, &req); err != nil {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{"message": "Invalid request body"})
            return
        }

        var users []migrations.User
        _ = db.FindAll(&users)
        var targetUser *migrations.User
        for _, u := range users {
            if u.Email == req.Email {
                targetUser = &u
                break
            }
        }

        if targetUser == nil {
            gohan.JSON(w, http.StatusOK, map[string]string{
                "message": "If your email is registered, you will receive a reset token.",
            })
            return
        }

        rawToken, err := gohan.GenerateRandomToken(32)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to generate token"})
            return
        }

        hashedToken, err := gohan.HashToken(rawToken)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": err.Error(),
            })
            return
        }

        var existingResets []migrations.PasswordReset
        _ = db.FindAll(&existingResets)
        for _, pr := range existingResets {
            if pr.Email == req.Email {
                _ = db.Delete(&migrations.PasswordReset{}, pr.ID)
            }
        }

        resetRecord := migrations.PasswordReset{
            Email:     req.Email,
            Token:     hashedToken,
            ExpiresAt: time.Now().Add(15 * time.Minute),
            CreatedAt: time.Now(),
        }

        if err := db.Create(&resetRecord); err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to save reset token"})
            return
        }

        emailSubject := "Password Reset Request"
        emailBody := fmt.Sprintf(`
            <h3>Password Reset Request</h3>
            <p>Hello,</p>
            <p>You are receiving this email because we received a password reset request for your account.</p>
            <p>Use the following token to reset your password (valid for 15 minutes):</p>
            <h2 style="background: #f4f4f4; padding: 10px; display: inline-block; border-radius: 4px;">%s</h2>
            <p>If you did not request a password reset, no further action is required.</p>
        `, rawToken)

        if err := gohan.SendEmail(req.Email, emailSubject, emailBody); err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to send reset email: " + err.Error()})
            return
        }

        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Password reset token sent successfully to your email.",
        })
    }
}

func ResetPassword(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        var req ResetPasswordRequest
        if err := gohan.BindJSON(r, &req); err != nil {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{"message": "Invalid request body"})
            return
        }

        hashedToken, err := gohan.HashToken(rawToken)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": err.Error(),
            })
            return
        }

        var resets []migrations.PasswordReset
        _ = db.FindAll(&resets)
        var targetReset *migrations.PasswordReset
        for _, pr := range resets {
            if pr.Email == req.Email && pr.Token == hashedToken {
                targetReset = &pr
                break
            }
        }

        if targetReset == nil {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{"message": "Invalid or expired reset token"})
            return
        }

        if time.Now().After(targetReset.ExpiresAt) {
            _ = db.Delete(&migrations.PasswordReset{}, targetReset.ID)
            gohan.JSON(w, http.StatusBadRequest, map[string]string{"message": "Reset token has expired"})
            return
        }

        var users []migrations.User
        _ = db.FindAll(&users)
        var targetUser *migrations.User
        for _, u := range users {
            if u.Email == req.Email {
                targetUser = &u
                break
            }
        }

        if targetUser == nil {
            gohan.JSON(w, http.StatusNotFound, map[string]string{"message": "User not found"})
            return
        }

        hashedPassword, err := gohan.HashPassword(req.NewPassword)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to hash password"})
            return
        }

        targetUser.Password = hashedPassword
        if err := db.Update(targetUser, targetUser.ID); err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to update password"})
            return
        }

        _ = db.Delete(&migrations.PasswordReset{}, targetReset.ID)

        gohan.JSON(w, http.StatusOK, map[string]string{
            "message": "Password updated successfully. Please login with your new password.",
        })
    }
}