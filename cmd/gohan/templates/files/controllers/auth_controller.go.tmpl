package controllers

import (
    "net/http"
{{- if ne .AuthType "jwt" }}
    "strings"
{{- end }}
    "time"

    "github.com/farkhanisturkia/gohan"
    "{{ .ModuleName }}/database/migrations"
)

type LoginRequest struct {
    Email    string `json:"email"`
    Password string `json:"password"`
}

func LoginAuth(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
        var req LoginRequest
        if err := gohan.BindJSON(r, &req); err != nil {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{"message": "Invalid request body"})
            return
        }

        var user migrations.User
        if err := db.FindOne(&user, "email = ?", req.Email); err != nil {
            gohan.JSON(w, http.StatusUnauthorized, map[string]string{"message": "Invalid email or password"})
            return
        }

        if !gohan.CheckPasswordHash(req.Password, user.Password) {
            gohan.JSON(w, http.StatusUnauthorized, map[string]string{"message": "Invalid email or password"})
            return
        }

{{- if eq .AuthType "jwt" }}
        env := gohan.GetEnv()

        duration, err := time.ParseDuration(env.JWTExpiration)
        if err != nil {
            duration = 24 * time.Hour
        }

        tokenStr, err := gohan.GenerateJWT(user.ID, user.Email, env.JWTSecret, duration)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to generate JWT token"})
            return
        }
{{- else }}
        tokenStr, err := gohan.GenerateRandomToken(32)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to generate token"})
            return
        }

        hashedToken, err := gohan.HashToken(tokenStr)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": err.Error(),
            })
            return
        }

        ipAddress := gohan.GetClientIP(r)
        userAgent := r.UserAgent()
        tokenName := gohan.ParseTokenName(userAgent)

        pat := migrations.PersonalAccessToken{
            UserID:    user.ID,
            Name:      tokenName,
            Token:     hashedToken,
            IPAddress: ipAddress,
            UserAgent: userAgent,
            ExpiresAt: time.Now().Add(7 * 24 * time.Hour),
            CreatedAt: time.Now(),
        }

        if err := db.Create(&pat); err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to save session"})
            return
        }
{{- end }}

        gohan.JSON(w, http.StatusOK, map[string]interface{}{
            "message": "Login successful",
            "token":   tokenStr,
            "user": map[string]interface{}{
                "id":    user.ID,
                "name":  user.Name,
                "email": user.Email,
            },
        })
    }
}

func LogoutAuth(db *gohan.DB) http.HandlerFunc {
    return func(w http.ResponseWriter, r *http.Request) {
{{- if eq .AuthType "jwt" }}
        gohan.JSON(w, http.StatusOK, map[string]string{
            "message": "Logout successful",
        })
{{- else }}
        authHeader := r.Header.Get("Authorization")
        if authHeader == "" {
            gohan.JSON(w, http.StatusBadRequest, map[string]string{"message": "Authorization header missing"})
            return
        }

        tokenStr := strings.TrimPrefix(authHeader, "Bearer ")

        hashedToken, err := gohan.HashToken(tokenStr)
        if err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{
                "message": err.Error(),
            })
            return
        }

        var pat migrations.PersonalAccessToken
        if err := db.FindOne(&pat, "token = ?", hashedToken); err != nil {
            gohan.JSON(w, http.StatusNotFound, map[string]string{"message": "Session not found"})
            return
        }

        if err := db.Delete(&migrations.PersonalAccessToken{}, pat.ID); err != nil {
            gohan.JSON(w, http.StatusInternalServerError, map[string]string{"message": "Failed to revoke token"})
            return
        }

        gohan.JSON(w, http.StatusOK, map[string]string{
            "message": "Logout successful",
        })
{{- end }}
    }
}