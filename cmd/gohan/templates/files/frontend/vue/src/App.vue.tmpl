<template>
  <div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
    <header class="border-b border-slate-800 p-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-6">
          <router-link to="/" class="text-xl font-bold tracking-tight text-emerald-400">
            🚀 {{ .ModuleName }}
          </router-link>
{{- if .UseAuth }}
          <nav v-if="isAuthenticated" class="flex space-x-4 text-sm font-medium text-slate-300">
            <router-link to="/dashboard" class="hover:text-white">Dashboard</router-link>
{{- if .UseRole }}
            <router-link v-if="isAdmin" to="/users" class="hover:text-white">Users</router-link>
{{- else }}
            <router-link to="/users" class="hover:text-white">Users</router-link>
{{- end }}
          </nav>
{{- end }}
        </div>

        <div class="flex items-center space-x-4">
{{- if .UseAuth }}
          <template v-if="isAuthenticated">
            <span class="text-xs text-slate-400 font-mono">{{ "{{" }} userEmail {{ "}}" }}</span>
            <button @click="logout" class="text-xs bg-rose-500/10 text-rose-400 border border-rose-500/20 px-3 py-1 rounded hover:bg-rose-500/20">
              Logout
            </button>
          </template>
          <template v-else>
            <router-link to="/login" class="text-xs bg-emerald-600 text-white px-3 py-1 rounded hover:bg-emerald-500">
              Login
            </router-link>
          </template>
{{- else }}
          <span class="text-xs bg-slate-800 text-slate-400 px-3 py-1 rounded-full border border-slate-700">
            Gohan Fullstack
          </span>
{{- end }}
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-5xl w-full mx-auto p-6">
      <router-view />
    </main>
  </div>
</template>

<script setup lang="ts">
{{- if .UseAuth }}
import { computed, onMounted } from 'vue'
import { useAuth } from '@/composables/useAuth'

const { user, isAuthenticated, fetchUser, logout } = useAuth()

const userEmail = computed(() => user.value ? user.value.email : '')

{{- if .UseRole }}
const isAdmin = computed(() => {
  if (!user.value?.role) return false
  const roleName = typeof user.value.role === 'object' ? user.value.role.name : user.value.role
  return roleName?.toLowerCase() === 'admin'
})
{{- end }}

onMounted(() => {
  fetchUser()
})
{{- end }}
</script>