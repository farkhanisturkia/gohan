                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  Delete
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- DESKTOP -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left text-sm text-purple-900/80 dark:text-slate-300">
            <thead class="bg-purple-50/70 dark:bg-slate-950/80 border-b border-purple-100 dark:border-slate-800 text-purple-950 dark:text-purple-300 uppercase text-[11px] font-bold tracking-wider">
              <tr>
                <th class="p-4 pl-6">ID</th>
                <th class="p-4">Name</th>
                <th class="p-4">Email</th>
{{- if .UseRole }}
                <th class="p-4">Role</th>
{{- end }}
                <th class="p-4 pr-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-purple-100/60 dark:divide-slate-800/80">
              <tr v-for="u in users" :key="u.id" class="hover:bg-purple-50/40 dark:hover:bg-slate-800/40 transition-colors">
                <td class="p-4 pl-6 font-mono text-xs text-purple-400 dark:text-slate-500">#{{ "{{" }} u.id {{ "}}" }}</td>
                <td class="p-4 font-bold text-purple-950 dark:text-purple-100">{{ "{{" }} u.name {{ "}}" }}</td>
                <td class="p-4 font-mono text-xs text-purple-900/70 dark:text-slate-400">{{ "{{" }} u.email {{ "}}" }}</td>
{{- if .UseRole }}
                <td class="p-4">
                  <span class="px-3 py-1 bg-purple-100 dark:bg-purple-950/60 text-purple-800 dark:text-purple-300 border border-purple-200 dark:border-purple-800/50 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider">
                    {{ "{{" }} getRoleName(u.role) {{ "}}" }}
                  </span>
                </td>
{{-  end }}
                <td class="p-4 pr-6 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <button 
                      @click="openEditModal(u)" 
                      title="Edit User"
                      class="p-2 text-amber-600 dark:text-amber-400 hover:bg-amber-100/80 dark:hover:bg-amber-950/50 rounded-xl transition-all cursor-pointer"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    </button>

                    <button 
                      @click="deleteUser(u.id)" 
                      title="Delete User"
                      class="p-2 text-rose-600 dark:text-rose-400 hover:bg-rose-100/80 dark:hover:bg-rose-950/50 rounded-xl transition-all cursor-pointer"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </template>

    </div>

    <!-- Create / Edit User Modal -->
    <div v-if="showModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-md flex items-center justify-center p-4 z-50">
      <div class="bg-white dark:bg-slate-900 border border-purple-100 dark:border-slate-800 rounded-3xl p-6 md:p-8 w-full max-w-md shadow-2xl relative overflow-hidden transition-colors duration-300">
        
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-bold text-purple-950 dark:text-purple-100">
            {{ "{{" }} isEditing ? 'Edit User' : 'Add New User' {{ "}}" }}
          </h3>
          <button @click="closeModal" class="text-purple-400 hover:text-purple-900 dark:hover:text-purple-200 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        
        <form @submit.prevent="handleSubmit" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-purple-900/70 dark:text-slate-400 mb-1.5">Name</label>
            <input 
              v-model="form.name" 
              type="text" 
              required 
              placeholder="Full Name"
              class="w-full px-4 py-2.5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800 rounded-xl text-purple-950 dark:text-white placeholder-purple-300 dark:placeholder-slate-600 focus:outline-none focus:border-purple-600 dark:focus:border-purple-500 text-sm transition-all" 
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-purple-900/70 dark:text-slate-400 mb-1.5">Email</label>
            <input 
              v-model="form.email" 
              type="email" 
              required 
              placeholder="name@example.com"
              class="w-full px-4 py-2.5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800 rounded-xl text-purple-950 dark:text-white placeholder-purple-300 dark:placeholder-slate-600 focus:outline-none focus:border-purple-600 dark:focus:border-purple-500 text-sm transition-all" 
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-purple-900/70 dark:text-slate-400 mb-1.5">
              Password <span v-if="isEditing" class="text-[10px] lowercase text-purple-400 font-normal">(leave blank to keep current)</span>
            </label>
            <input 
              v-model="form.password" 
              type="password" 
              :required="!isEditing"
              placeholder="••••••••"
              class="w-full px-4 py-2.5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800 rounded-xl text-purple-950 dark:text-white placeholder-purple-300 dark:placeholder-slate-600 focus:outline-none focus:border-purple-600 dark:focus:border-purple-500 text-sm transition-all" 
            />
          </div>
{{- if .UseRole }}
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-purple-900/70 dark:text-slate-400 mb-1.5">Role</label>
            <select 
              v-model="form.role_id" 
              required 
              class="w-full px-4 py-2.5 bg-purple-50/50 dark:bg-slate-950 border border-purple-100 dark:border-slate-800 rounded-xl text-purple-950 dark:text-white focus:outline-none focus:border-purple-600 dark:focus:border-purple-500 text-sm capitalize transition-all"
            >
              <option :value="0" disabled>Select Role</option>
              <option v-for="r in roles" :key="r.id" :value="r.id">
                {{ "{{" }} r.name {{ "}}" }}
              </option>
            </select>
          </div>
{{- end }}
          <div class="flex items-center justify-end space-x-3 pt-4">
            <button 
              type="button" 
              @click="closeModal" 
              class="px-5 py-2.5 bg-purple-50 dark:bg-slate-800 hover:bg-purple-100 dark:hover:bg-slate-700 text-purple-900 dark:text-slate-300 font-bold rounded-full text-xs transition-all cursor-pointer"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              :disabled="isSubmitting" 
              class="px-5 py-2.5 bg-purple-800 hover:bg-purple-900 dark:bg-purple-700 dark:hover:bg-purple-600 text-white font-bold rounded-full text-xs transition-all shadow-md uppercase tracking-wider cursor-pointer"
            >
              {{ "{{" }} submitBtnText {{ "}}" }}
            </button>
          </div>
