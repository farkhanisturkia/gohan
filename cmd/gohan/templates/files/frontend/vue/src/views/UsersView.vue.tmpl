</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted } from 'vue'
import { useQuery, useMutation, useQueryClient } from '@tanstack/vue-query'
import api from '@/lib/axios'

{{- if .UseRole }}
interface Role {
  id: number
  name: string
}
{{- end }}

interface User {
  id: number
  name: string
  email: string
{{- if .UseRole }}
  role_id?: number
  role?: Role | string
{{- end }}
}

const queryClient = useQueryClient()
const showModal = ref(false)
const isEditing = ref(false)
const editingUserId = ref<number | null>(null)
const activeMenuId = ref<number | null>(null)

const form = ref({
  name: '',
  email: '',
  password: '',
{{- if .UseRole }}
  role_id: 0,
{{- end }}
})

// Toggle Dropdown Menu pada Mobile
const toggleActionMenu = (id: number) => {
  activeMenuId.value = activeMenuId.value === id ? null : id
}

const closeAllMenus = () => {
  activeMenuId.value = null
}

const handleEditFromMenu = (user: User) => {
  closeAllMenus()
  openEditModal(user)
}

const handleDeleteFromMenu = (id: number) => {
  closeAllMenus()
  deleteUser(id)
}

// Global click listener untuk menutup dropdown saat klik luar
onMounted(() => {
  window.addEventListener('click', closeAllMenus)
})

onUnmounted(() => {
  window.removeEventListener('click', closeAllMenus)
})

{{- if .UseRole }}
// Fetch Roles
const { data: roles } = useQuery<Role[]>({
  queryKey: ['roles'],
  queryFn: async () => {
    const res = await api.get('/api/roles')
    return res.data.data
  },
})

// Type Guard untuk mengecek apakah role berupa Object
const isRoleObject = (role?: Role | string): role is Role => {
  return typeof role === 'object' && role !== null && 'name' in role
}

// Extract role name safely
const getRoleName = (role?: Role | string): string => {
  if (!role) return 'user'
  if (isRoleObject(role)) {
    return role.name && role.name.trim() !== '' ? role.name : 'user'
  }
  return String(role)
}

// Extract role ID safely
const getRoleId = (user: User): number => {
  if (user.role_id) return user.role_id
  
  if (isRoleObject(user.role)) {
    return user.role.id || 0
  }

  if (roles.value && typeof user.role === 'string') {
    const roleName = user.role
    const found = roles.value.find(r => r.name.toLowerCase() === roleName.toLowerCase())
    if (found) return found.id
  }

  return 0
}
{{- end }}

// Open modal for Create
const openCreateModal = () => {
  isEditing.value = false
  editingUserId.value = null
  form.value = { 
    name: '', 
    email: '', 
    password: '', 
{{- if .UseRole }}
    role_id: 0 
{{- end }}
  }
  showModal.value = true
}

// Open modal for Edit
const openEditModal = (user: User) => {
  isEditing.value = true
  editingUserId.value = user.id
  form.value = {
    name: user.name,
    email: user.email,
    password: '',
{{- if .UseRole }}
    role_id: getRoleId(user),
{{- end }}
  }
  showModal.value = true
}

const closeModal = () => {
  showModal.value = false
}

// Fetch Users
const { data: users, isLoading, isError } = useQuery<User[]>({
  queryKey: ['users'],
  queryFn: async () => {
    const res = await api.get('/api/users')
    return res.data.data.data
  },
})

// Create User Mutation
const createMutation = useMutation({
  mutationFn: async (newUser: typeof form.value) => {
    await api.post('/api/users', newUser)
  },
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['users'] })
    closeModal()
  },
})

// Update User Mutation
const updateMutation = useMutation({
  mutationFn: async ({ id, data }: { id: number; data: typeof form.value }) => {
    const payload: Record<string, any> = {
      name: data.name,
      email: data.email,
{{- if .UseRole }}
      role_id: data.role_id,
{{- end }}
    }
    if (data.password) {
      payload.password = data.password
    }
    await api.put(`/api/users/${id}`, payload)
  },
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['users'] })
    closeModal()
  },
})

const isSubmitting = computed(() => {
  return createMutation.isPending.value || updateMutation.isPending.value
})

const submitBtnText = computed(() => {
  if (isSubmitting.value) return 'Saving...'
  return isEditing.value ? 'Update User' : 'Save User'
})

const handleSubmit = () => {
  if (isEditing.value && editingUserId.value) {
    updateMutation.mutate({ id: editingUserId.value, data: form.value })
  } else {
    createMutation.mutate(form.value)
  }
}

// Delete User Mutation
const deleteMutation = useMutation({
  mutationFn: async (id: number) => {
    await api.delete(`/api/users/${id}`)
  },
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['users'] })
  },
})

const deleteUser = (id: number) => {
  if (confirm('Are you sure you want to delete this user?')) {
    deleteMutation.mutate(id)
  }
}
</script>