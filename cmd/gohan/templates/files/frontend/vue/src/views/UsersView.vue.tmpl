<template>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-white">Users Management</h2>
      <button 
        @click="showCreateModal = true"
        class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg text-sm transition-colors"
      >
        + Add User
      </button>
    </div>

    <!-- Users Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase text-xs">
          <tr>
            <th class="p-4">ID</th>
            <th class="p-4">Name</th>
            <th class="p-4">Email</th>
{{- if .UseRole }}
            <th class="p-4">Role</th>
{{- end }}
            <th class="p-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <tr v-if="isLoading">
            <td colspan="5" class="p-4 text-center text-slate-500">Loading users...</td>
          </tr>
          <tr v-else-if="isError">
            <td colspan="5" class="p-4 text-center text-rose-400">Failed to load users</td>
          </tr>
          <tr v-else v-for="u in users" :key="u.id" class="hover:bg-slate-800/50">
            <td class="p-4">{{ "{{" }} u.id {{ "}}" }}</td>
            <td class="p-4 font-medium text-white">{{ "{{" }} u.name {{ "}}" }}</td>
            <td class="p-4">{{ "{{" }} u.email {{ "}}" }}</td>
{{- if .UseRole }}
            <td class="p-4">
              <span class="px-2 py-1 bg-slate-800 text-emerald-400 rounded text-xs font-mono">
                {{ "{{" }} getRoleName(u.role) {{ "}}" }}
              </span>
            </td>
{{- end }}
            <td class="p-4 text-right space-x-2">
              <button @click="deleteUser(u.id)" class="text-rose-400 hover:underline">Delete</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Create User Modal -->
    <div v-if="showCreateModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 w-full max-w-md shadow-2xl">
        <h3 class="text-xl font-bold text-white mb-4">Add New User</h3>
        
        <form @submit.prevent="createUser" class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Name</label>
            <input v-model="form.name" type="text" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Email</label>
            <input v-model="form.email" type="email" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Password</label>
            <input v-model="form.password" type="password" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-emerald-500" />
          </div>

{{- if .UseRole }}
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Role</label>
            <select v-model="form.role" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-emerald-500">
              <option value="user">User</option>
              <option value="admin">Admin</option>
            </select>
          </div>
{{- end }}

          <div class="flex justify-end space-x-3 mt-6">
            <button type="button" @click="showCreateModal = false" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm">Cancel</button>
            <button type="submit" :disabled="createMutation.isPending.value" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg text-sm">
              {{ "{{" }} submitBtnText {{ "}}" }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'
import { useQuery, useMutation, useQueryClient } from '@tanstack/vue-query'
import api from '../lib/axios'

interface User {
  id: number
  name: string
  email: string
  role?: string
}

const queryClient = useQueryClient()
const showCreateModal = ref(false)

const form = ref({
  name: '',
  email: '',
  password: '',
  role: 'user',
})

const getRoleName = (role?: string): string => {
  return role ? role : 'user'
}

const submitBtnText = computed(() => {
  return createMutation.isPending.value ? 'Creating...' : 'Save User'
})

// Fetch Users
const { data: users, isLoading, isError } = useQuery<User[]>({
  queryKey: ['users'],
  queryFn: async () => {
    const res = await api.get('/api/users')
    return res.data.data
  },
})

// Create User Mutation
const createMutation = useMutation({
  mutationFn: async (newUser: typeof form.value) => {
    await api.post('/api/users', newUser)
  },
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['users'] })
    showCreateModal.value = false
    form.value = { name: '', email: '', password: '', role: 'user' }
  },
})

const createUser = () => {
  createMutation.mutate(form.value)
}

// Delete User Mutation
const deleteMutation = useMutation({
  mutationFn: async (id: number) => {
    await api.delete(`/api/users/${id}`)
  },
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['users'] })
  },
})

const deleteUser = (id: number) => {
  if (confirm('Are you sure you want to delete this user?')) {
    deleteMutation.mutate(id)
  }
}
</script>