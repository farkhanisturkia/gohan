<script setup lang="ts">
import { computed } from 'vue'
import { useQuery } from '@tanstack/vue-query'
import api from '@/lib/axios'

interface VersionResponse {
  message: string
  version: string
}

interface PingResponse {
  message: string
}

interface PublicResponse {
  result: string
}

{{- if .UseAuth }}
const authStrategy = '{{ if eq .AuthType "jwt" }}JWT{{ else }}PAT{{ end }}'
{{- end }}

// Fetch App Version
const { data: versionData } = useQuery<VersionResponse, Error>({
  queryKey: ['version'],
  queryFn: async () => {
    const res = await api.get('/version')
    return res.data
  },
})

const gohanVersion = computed<string>(() => {
  return versionData.value?.version ? `version ${versionData.value.version}` : 'version loading...'
})

// Fetch Ping Status
const { data: pingData, isLoading: pingLoading, error: pingError } = useQuery<PingResponse, Error>({
  queryKey: ['ping'],
  queryFn: async () => {
    const res = await api.get('/ping')
    return res.data
  },
})

// Fetch Public Status
const { data: publicData, isLoading: publicLoading, error: publicError } = useQuery<PublicResponse, Error>({
  queryKey: ['check-public'],
  queryFn: async () => {
    const res = await api.get('/check-public')
    return res.data
  },
})

const pingDisplay = computed<string>(() => {
  if (pingData.value) return JSON.stringify(pingData.value, null, 2)
  if (pingError.value) return pingError.value.message
  return 'Fetching data...'
})

const publicDisplay = computed<string>(() => {
  if (publicData.value) return JSON.stringify(publicData.value, null, 2)
  if (publicError.value) return publicError.value.message
  return 'Fetching data...'
})
</script>