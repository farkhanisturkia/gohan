<script setup lang="ts">
import { ref, computed } from 'vue'
import { useRouter } from 'vue-router'
import Cookies from 'js-cookie'
import axios from 'axios'
import api from '@/lib/axios'
import { useAuth } from '@/composables/useAuth'

{{- if .UseForgotPassword }}
const mode = ref<'login' | 'forgot'>('login')
const infoMessage = ref('')
{{- else }}
const mode = ref<'login'>('login')
{{- end }}

const email = ref('')
const password = ref('')
const rememberMe = ref(false)
const loading = ref(false)
const errorMessage = ref('')
const router = useRouter()

const buttonText = computed(() => {
  return loading.value ? 'AUTHENTICATING...' : 'LOGIN'
})

const { fetchUser } = useAuth()

{{- if .UseForgotPassword }}
const switchMode = (targetMode: 'login' | 'forgot') => {
  mode.value = targetMode
  errorMessage.value = ''
  infoMessage.value = ''
}
{{- end }}

const switchToSignup = () => {
  router.push('/register')
}

const handleLogin = async () => {
  loading.value = true
  errorMessage.value = ''
  try {
    const res = await api.post('/api/login', {
      email: email.value,
      password: password.value,
    })

    const token = res.data.token || res.data.data?.token
    if (token) {
      const expires = rememberMe.value ? 7 : 1
      Cookies.set('token', token, { expires })
    }

    await fetchUser()
    await router.push('/dashboard')
  } catch (err: unknown) {
    if (axios.isAxiosError(err)) {
      errorMessage.value = err.response?.data?.message || 'Login failed. Invalid credentials.'
    } else {
      errorMessage.value = 'An unexpected error occurred.'
    }
  } font-medium {
    loading.value = false
  }
}

{{- if .UseForgotPassword }}
const handleForgotPassword = async () => {
  if (!email.value) {
    errorMessage.value = 'Silakan isi email terlebih dahulu.'
    return
  }

  loading.value = true
  errorMessage.value = ''
  infoMessage.value = ''

  try {
    await api.post('/api/forgot-password', { email: email.value })
    infoMessage.value = 'Instruksi reset password telah dikirim ke email kamu.'
  } catch (err: unknown) {
    if (axios.isAxiosError(err)) {
      errorMessage.value = err.response?.data?.message || 'Gagal mengirim email reset password.'
    } else {
      errorMessage.value = 'An unexpected error occurred.'
    }
  } finally {
    loading.value = false
  }
}
{{- end }}
</script>