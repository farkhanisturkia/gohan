<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { useRoute } from 'vue-router'
import api from '@/lib/axios'

const route = useRoute()

const isResetMode = ref(false)
const email = ref('')
const token = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
const showNewPassword = ref(false)
const showConfirmPassword = ref(false)

const isSubmitting = ref(false)
const errorMessage = ref('')
const successMessage = ref('')

onMounted(() => {
  const queryToken = route.query.token as string
  const queryEmail = route.query.email as string

  if (queryToken && queryEmail) {
    isResetMode.value = true
    token.value = queryToken
    email.value = queryEmail
  }
})

const handleRequestLink = async () => {
  errorMessage.value = ''
  successMessage.value = ''
  isSubmitting.value = true

  try {
    const res = await api.post('/api/forgot-password', { email: email.value })
    successMessage.value = res.data.message || 'A password reset link has been sent to your email.'
  } catch (err: any) {
    errorMessage.value = err.response?.data?.error || err.response?.data?.message || 'Failed to send the password reset email.'
  } finally {
    isSubmitting.value = false
  }
}

const handleResetPassword = async () => {
  errorMessage.value = ''
  successMessage.value = ''

  if (newPassword.value !== confirmPassword.value) {
    errorMessage.value = 'Password confirmation does not match'
    return
  }

  isSubmitting.value = true

  try {
    const res = await api.post('/api/reset-password', {
      email: email.value,
      token: token.value,
      new_password: newPassword.value
    })
    successMessage.value = res.data.message || 'Your password has been successfully updated. Please log in again.'
  } catch (err: any) {
    errorMessage.value = err.response?.data?.error || err.response?.data?.message || 'Failed to reset the password.'
  } finally {
    isSubmitting.value = false
  }
}
</script>

