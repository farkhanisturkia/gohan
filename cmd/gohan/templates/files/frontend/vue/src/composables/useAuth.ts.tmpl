import { ref } from 'vue'
import Cookies from 'js-cookie'
import api from '@/lib/axios'

interface User {
  id: number
  name: string
  email: string
{{- if .UseRole }}
  role?: string | { id: number; name: string }
{{- end }}
}

const user = ref<User | null>(null)

export function useAuth() {
  const isAuthenticated = computed(() => !!user.value || !!Cookies.get('token'))

  const fetchUser = async () => {
    if (!Cookies.get('token')) {
      user.value = null
      return null
    }
    try {
      const res = await api.get('/api/me')
      user.value = res.data.data ?? res.data
      return user.value
    } catch {
      user.value = null
      Cookies.remove('token')
      return null
    }
  }

  const logout = async () => {
    try {
      await api.post('/api/logout')
    } catch (e) {
      console.error(e)
    } finally {
      Cookies.remove('token')
      user.value = null
      window.location.href = '/login'
    }
  }

  return {
    user,
    isAuthenticated,
    fetchUser,
    logout,
  }
}