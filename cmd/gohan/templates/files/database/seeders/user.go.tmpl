package seeders

import (
    "log"

    "github.com/farkhanisturkia/gohan"
    "{{ .ModuleName }}/database/migrations"
)

func UserSeeder(db *gohan.DB) {
{{- if .UseRole }}
    var adminRole, userRole migrations.Role
    
    if err := db.FindOne(&adminRole, "name = ?", "admin"); err != nil {
        log.Println("[error] User seeder cancelled: 'admin' role not found in database. Run RoleSeeder first.")
        return
    }

    if err := db.FindOne(&userRole, "name = ?", "user"); err != nil {
        log.Println("[error] User seeder cancelled: 'user' role not found in database. Run RoleSeeder first.")
        return
    }
{{- end }}

    hashedPassword, err := gohan.HashPassword("password")
    if err != nil {
        log.Fatalf("[error] Failed to hash password: %v\n", err)
    }

    users := []migrations.User{
        {
            Name:     "User",
            Email:    "user@example.com",
            Password: hashedPassword,
{{- if .UseRole }}
            RoleID:   userRole.ID,
{{- end }}
        },
        {
            Name:     "Administrator",
            Email:    "admin@example.com",
            Password: hashedPassword,
{{- if .UseRole }}
            RoleID:   adminRole.ID,
{{- end }}
        },
    }

    for _, user := range users {
        var existingUser migrations.User
        if err := db.FindOne(&existingUser, "email = ?", user.Email); err == nil {
            log.Printf("[info] User seeder skipped for '%s': Data already exists\n", user.Email)
            continue
        }

        if err := db.Create(&user); err != nil {
            log.Printf("[error] Failed to seed user (%s): %v\n", user.Email, err)
        } else {
            log.Printf("[info] User '%s' successfully seeded\n", user.Email)
        }
    }

    log.Println("[info] User seeder process completed")
}