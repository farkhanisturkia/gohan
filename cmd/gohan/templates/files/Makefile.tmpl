.PHONY: setup dev dev-backend{{ if eq .AppType "fullstack" }} dev-frontend{{ end }}{{ if .UseRedis }} clear-cache{{ end }}

setup:
	@echo "📦 Setting up all dependencies..."
{{- if eq .AppType "fullstack" }}
	@cd backend && (test -f go.mod || go mod init {{ .ModuleName }}) && go mod tidy && gohan key:generate
	@cd frontend && npm install --no-fund --no-audit
{{- else }}
	@(test -f go.mod || go mod init {{ .ModuleName }}) && go mod tidy && gohan key:generate
{{- end }}
	@echo "✅ Setup completed!"

{{- if .UseRedis }}
clear-cache:
	@echo "🧹 Clearing Redis cache..."
	@-redis-cli flushdb > /dev/null 2>&1 || echo "⚠️  Redis-cli not available or service unreachable, skipping..."

{{- end }}
dev:
{{- if eq .AppType "fullstack" }}
	@echo "🚀 Starting Backend and Frontend..."
	@make -j2 dev-backend dev-frontend
{{- else }}
	@make dev-backend
{{- end }}

{{- if .UseRedis }}
dev-backend: clear-cache
{{- else }}
dev-backend:
{{- end }}
{{- if eq .AppType "fullstack" }}
	@cd backend && go run .
{{- else }}
	@go run .
{{- end }}

{{- if eq .AppType "fullstack" }}
dev-frontend:
	@cd frontend && npm run dev
{{- end }}